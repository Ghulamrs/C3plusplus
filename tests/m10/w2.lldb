# lldb -b -s: the stops of w2.gdb, args (-l) and locals (-a) apart as gdb's info args and info locals
settings set stop-line-count-before 0
settings set stop-line-count-after 0
settings set stop-disassembly-display never
settings set target.output-path /dev/null
breakpoint set -f w2.cpp -l 21
breakpoint set -f w2.cpp -l 23
run
script print("== in the block, 21")
frame variable -l
frame variable -a
bt
continue
script print("== after the block, 23")
frame variable -a
frame variable counter
frame variable ratio
kill
