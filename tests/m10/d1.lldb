# lldb -b -s: the stops of d1.gdb, args (-l) and locals (-a) apart as gdb's info args and info locals
settings set stop-line-count-before 0
settings set stop-line-count-after 0
settings set stop-disassembly-display never
settings set target.output-path /dev/null
breakpoint set -f d1.cpp -l 7
breakpoint modify -i 2 1
run
script print("== square at 7, third call")
frame variable -l
frame variable -a
bt
script print("== sum")
frame select 1
frame variable -l
frame variable -a
script print("== main")
frame select 2
frame variable -a
breakpoint delete -f
breakpoint set -f d1.cpp -l 18
continue
script print("== sum at 18")
frame variable -l
frame variable -a
kill
