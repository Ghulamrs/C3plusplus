# lldb -b -s: the stops of d2.gdb, args (-l) and locals (-a) apart as gdb's info args and info locals
settings set stop-line-count-before 0
settings set stop-line-count-after 0
settings set stop-disassembly-display never
settings set target.output-path /dev/null
breakpoint set -f d2.cpp -l 10
run
script print("== fact at 10, n == 1")
frame variable -l
frame variable -a
bt
script print("== fact, n == 2")
frame select 1
frame variable -l
frame variable -a
script print("== fact, n == 3")
frame select 2
frame variable -l
frame variable -a
kill
