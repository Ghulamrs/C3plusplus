#!/bin/sh
# **The wave gate, as one script** (the M6c review's R105, 2026-11-15). Every step below prints one line - PASS,
# FAIL, or NOT RUN with its reason - and the last line fails when a step failed or was not run without a reason
# given on the command line. A step not typed can no longer be a step not run and not reported.
#
#   tools/wave-gate <name> [-n <step>[,<step>...]=<reason>]... [-b linux,windows,mac] [-B <step>=<box>,...]
#                          [-w <base>] [-m <milestone>] [-t <commit>] [-a mfixed] [-k] [-r] [-p]
#
# Run from the Mac, which only ships and asks: the tree is HEAD as `git archive` writes it (the commit is printed);
# the Linux box builds it in ~/<name> and runs its chain detached, two steps at once, each box job through ~/slot
# (the first free of two locks, -j2/JOBS=2 each; installed from SLOT below when missing) under the 25-minute cap; the Windows box builds it in <work>\<name> (tools/windows/winbuild.sh) and the Mac in
# $WAVEGATE_MAC/<name>, one Mac job at a time at -j2. `-n` names steps this wave does not owe, with the reason the
# report prints; a group name (tms, wtms, winpass, fixed, mac, windows, linux) stands for its steps. `-b` keeps the
# run to some boxes - the others' steps are NOT RUN and want a reason like any other. `-r` runs nothing: the report
# again from the verdicts a run left in $WAVEGATE_OUT/<name>. `-k` keeps those verdicts and runs only the steps that
# have none yet (a chain cut by the box, or a step added), in the trees already built.
#
# **The steps and their boxes are one table, BOXTAB below** (the user's split, 2026-11-15, second form): linux runs
# what executes x86_64-linux code, two at a time in the two slots; windows the Windows-only steps, pinned to its ten,
# as many at once as WINLANES (10) holds - a wide step WINLANES/2 lanes, a narrow one 2 - back to back (pool below); `split` steps
# run SHARD=k/6, k=1-3 on Linux and k=4-6 on Windows at once, and join into one verdict (counts summed, cycles.txt
# concatenated); `idle` steps (the -S comparisons) go to whichever leg asks first after its own, and say so.
# `-B step=box` (or WAVEGATE_BOXES) overrides a row for one run. `-t` ships that commit's tree, not HEAD's;
# `-p` prints each box's list and runs nothing. WAVEGATE_HALVES=1 with `-b <box>` (and -k) runs that box's half alone.
# A verdict is FAIL when its box's disk is above 70% (the user's limit) as it is written.
# tms<L>/wtms<L>: tests/tms6747.sh at -O<L> on the selector / the walker (CXX1_C6X_WALKER=1), six shards, SIM=0;
# -O1 is R107's leg. **The wave's base (`-w <commit>`, main at the wave's start)** is built by `build` beside the
# gated tree, on Linux: identical (tms6747), identlnx, identwin, identa64 are tools/identical.sh at -O0, -O1, -O2
# against it, and emit is tests/emit.sh --o2 against a golden the base records in the same run (none is a FAIL).
# **A difference is a PASS only when tests/wave-expected.txt names it** (`<case> <target> <level> <reason>`), and a
# named one that does not differ fails as well (N2); cycles' WORSE rows are judged by the same file. A wave lands
# only on 0 failed, every expected difference named in a file the gate reads (the user, 2026-11-15, QA). baselines: the
# judges' files at the Mac's HEAD are the gated commit's - one changed after the run fails it. census: tools/ssa-census
# -arch tms6747 at -O2 (outside=, walked) and -O0 (walked), its own status the verdict (N1). release:
# tools/c6747/release-check-box.py on the Windows box (N5). ssa1/ssa2: tests/ssa.sh at SSA_LEVEL 1, 2; run2: run.sh -O2.
# subst: tests/subst.sh, -templates=subst against off (R109). declines: tools/c6x-declines --check, the count only down (R108, Q5). asm<L>: tests/asm6x.sh at -O<L>, -O1 included. selfc: stage 0 compiles every
# src/*.cpp. run1/winpass1: the x86 cases at -O1. cdb wants the LINK a winpass builds (winout-tools).
# **sim: tests/tms6747.sh -O2 with SIM=1** (asm6x, lnk6x, TI's runtime, sim6747), the six shards, in every wave gate -
# the user's decision on the M6c review's Q4, 2026-11-15: the Linux time is accepted.
# **names, overload, winstruct: tests/names.sh, overload.sh and win-structure.sh on the Windows box** in every wave
# gate, with its clang 19.1.5 - the user's decision on Q9, 2026-11-15: the Windows box is their standing home,
# and nothing is installed on Linux (where `make test` skips them for want of clang++).
# **fixed<L>, wfixed<L>: the self-host fixed point** - stages 0 = 1 = 2 and 2 = 3 at -O<L>, tools/self-host on
# Linux and tools/windows/self-host.cmd in the MASM spelling on Windows. **The script decides whether it is owed**
# (N4): at a milestone's close (`-m <milestone>`), or when base..commit adds or deletes a src/ file or takes 100 src/
# lines away net; otherwise NOT RUN with that check as its reason. `-n` cannot excuse it.
# **mfixed: target 4's fixed point on the Mac** (arm64-darwin, tools/self-host at -O0 and -O2) is not a wave step -
# the user's decision on Q4b, 2026-11-15: only at a milestone's close, one Mac job at a time under the caps. It
# runs, and is reported, only under `-a mfixed`.
set -u
# step=box, in the report's order. linux | windows | mac | split (shards 1-3 Linux, 4-6 Windows) | idle (either)
BOXTAB="build=linux static=linux gdb=linux run1=linux run2=linux maketest=linux ssa1=linux ssa2=linux subst=linux
 selfc=linux fixed0=linux fixed2=linux identical=linux identlnx=linux identwin=linux identa64=linux emit=linux
 wbuild=windows winpass0=windows winpass1=windows winpass2=windows cdb=windows wselfc=windows names=windows
 overload=windows winstruct=windows release=windows wfixed0=windows wfixed2=windows
 tms0=split tms1=split tms2=split wtms0=split wtms1=split wtms2=split sim=split
 census=idle declines=idle asm0=idle asm1=idle asm2=idle cycles=idle
 mbuild=mac mrun0=mac mrun2=mac lldb=mac baselines=report"
# the judges' files: one changed at the Mac's HEAD after the gated commit fails `baselines` (N2)
BASELINES="tests/tms6747-cycles.txt tools/c6x-walked.baseline tools/c6x-declines.baseline tests/wave-expected.txt"
STEPS_asked="mfixed"; NSHARD=6; SPLIT_LINUX=1-3; SPLIT_WINDOWS=4-6
# ~/slot on the Linux box is a copy of this text (the user, 2026-11-15: two slots on the 4 vCPU); installed when missing
SLOT='#!/bin/sh
# ~/slot <cmd...>: run one box job in either of two slots (the user, 2026-11-15: keep the 4 vCPU busy) - the
# first free of ~/.boxleg.lock.1 and .2, waiting for whichever frees first; each job at -j2 / JOBS=2 by default.
# The old single lock ~/.boxleg.lock is still honoured by a job that takes it (the wave-20 gate, started before).
export MAKEFLAGS=${MAKEFLAGS:--j2} JOBS=${JOBS:-2} SELFHOST_JOBS=${SELFHOST_JOBS:-2}
while :; do
  for s in 1 2; do
    exec 9>"$HOME/.boxleg.lock.$s"
    if flock -n 9; then echo "slot $s: $*" >&2; "$@"; rc=$?; flock -u 9; exit $rc; fi
  done
  sleep 5
done'
# steps that write one folder of the tree (tests/out-run, out-tms6747, out-asm6x, winout) never overlap; winpass*,
# cdb and wfixed* share winout-tools (each winpass job and wfixed rebuild its masm and LINK, cdb links with it)
fam() { case $1 in run1|run2|maketest) echo run;; ssa1|ssa2) echo ssa;; tms*|wtms*|sim*) echo tms;; asm*) echo asm;;
    winpass*|cdb|wfixed*) echo wintools;; *) echo "$1";; esac; }
# a step that relinks its tree's compiler runs alone on its box: wselfc and wfixed* call msvc\build.cmd, which writes
# cxx3-msvc.exe under every step running it (w21g: wtms2's "Device or resource busy"); Linux's checks make -q instead
alone() { case $1 in wselfc|wfixed*) return 0;; esac; return 1; }
# pool <cap> <run> <width> [<more>] <step>...: each step in the background as `<run> <step> <w>` while the widths in
# flight fit in <cap> and no step of its family runs; `<width> <step> <free> <left>` prints w (empty: not ready yet);
# `<more>` (or -) is asked for another step when the list is empty. A step starts the moment one fits: no idle gap.
pool() { cap=$1 prun=$2 pwid=$3 pmore=$4; shift 4; pq="$*" pr=
    while :; do l=; used=0
        for e in $pr; do p=${e%%:*}; w=${e##*:}; if kill -0 "$p" 2>/dev/null; then l="$l $e"; used=$((used + w)); fi; done; pr=$l; go=
        if [ -z "$pq" ] && [ "$pmore" != - ]; then m=$($pmore); [ -n "$m" ] && pq=$m; fi
        n=0; for s in $pq; do n=$((n + 1)); done
        for s in $pq; do f=$(fam "$s"); busy=; alone "$s" && [ -n "$pr" ] && busy=1
            for e in $pr; do x=${e#*:}; x=${x%:*}; [ "$(fam "$x")" = "$f" ] && busy=1; alone "$x" && busy=1; done; [ -z "$busy" ] || continue
            w=$($pwid "$s" $((cap - used)) $n); [ -n "$w" ] || continue
            [ $((used + w)) -le "$cap" ] || [ -z "$pr" ] || continue
            "$prun" "$s" "$w" & pr="$pr $!:$s:$w"; used=$((used + w)); go=1
            pq=$(for x in $pq; do [ "$x" = "$s" ] || printf '%s ' "$x"; done); break; done
        [ -n "$go" ] && continue; [ -z "$pq$pr" ] && break; sleep 5; done; wait; }
# ---- the Windows box's side, under Git's bash in the built tree: sh tools/wave-gate --suite names|overload|win-structure
if [ "${1:-}" = --suite ]; then
    PATH="$(dirname "$(cygpath -u "${CXX1_WINDOWS_CLANG:-C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\Llvm\x64\bin\clang.exe}")"):$PATH"
    export PATH CLANG=clang++ CXX1=./cxx3-msvc.exe REQUIRE_ORACLE=1     # r6d: a missing oracle is exit 3, a FAIL here
    command -v clang++ > /dev/null || { echo "wave-gate: no clang++ on the Windows box's PATH"; exit 2; }
    sh "tests/$2.sh"; rc=$?; echo "wave-gate: $2.sh rc $rc"; exit $rc     # the status as a line: `start /wait` loses it
fi

# ---- a box's side: sh wave-gate --box linux|windows <name> <step>...  (Windows: Git's bash, in the built tree)
if [ "${1:-}" = --box ]; then
    B=$2; N=$3; shift 3
    if [ "$B" = windows ]; then T=$(pwd); V=$T/../$N-verdicts.txt; LOG=$T/../$N; X=${WAVEGATE_TI6X:-/c/Users/GRA/work/ti6x}
        export CXX1=./cxx3-msvc.exe JOBS=${WINLANES:-10} TIRTS=${WAVEGATE_TIRTS:-/c/ti/c6747-lib}
        job() { c=$1; shift; timeout "$c" "$@"; }                                # the caller pins the affinity
        # python3 on this box is the Store's stub (asm6x.sh's 837 failures in r6w's run): a shim to the real one first
        PY=${WAVEGATE_PYTHON:-/c/Program Files/Python312/python.exe}; mkdir -p "$T/../$N-py3"
        [ -x "$T/../$N-py3/python3" ] || { printf '#!/bin/sh\nexec "%s" "$@"\n' "$PY" > "$T/../$N-py3/p.$$"; chmod +x "$T/../$N-py3/p.$$"; mv "$T/../$N-py3/p.$$" "$T/../$N-py3/python3"; }; PATH=$T/../$N-py3:$PATH
    else T=$HOME/$N; V=$HOME/$N-verdicts.txt; LOG=$HOME/$N; X=$HOME/ti6x
        export TMPDIR=$T/tmp TIRTS=$HOME/c6747-lib
        [ -x "$HOME/slot" ] || { printf '%s\n' "$SLOT" > "$HOME/slot.$$" && chmod +x "$HOME/slot.$$" && mv "$HOME/slot.$$" "$HOME/slot"; }
        job() { c=$1; shift; "$HOME/slot" timeout "$c" "$@"; }       # one box job: either slot, then the cap
    fi
    export PATH=$X/ASM6x/build:$X/LNK6x/build:$X/VM6747:$X/SIM6747:$PATH SIM6747=$X/SIM6747/sim6747.exe \
        VM=$X/VM6747/vm6747.exe ASM6X=$X/ASM6x/build/asm6x.exe LNK6X=$X/LNK6x/build/lnk6x.exe \
        RTSLIB=rts6740_elf_eh.lib C6XDIFF=$X/ASM6x/tests/c6xdiff.py
    # the user's disk limit: a PASS written while the box is above 70% is a FAIL
    verdict() { u=$(df -P . | awk 'NR == 2 { sub("%", "", $5); print $5 }'); set -- "$1" "$2" "$3"
        [ "$2" = PASS ] && [ "${u:-0}" -gt 70 ] && set -- "$1" FAIL "disk $u% on this box, over 70%; $3"
        printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$V"; printf 'VERDICT\t%s\t%s\t%s\n' "$1" "$2" "$3"; echo "$1: $2 - $3 ($(date +%H:%M))"; }
    capnote() { [ "$1" -eq 124 ] && echo " (cut at its cap)"; }
    # one suite, one box job: $1 step, $2 the line that carries its count, the rest the command
    suite() { s=$1; pat=$2; shift 2; job 1500 "$@" > "$LOG-$s.log" 2>&1; rc=$?
        d=$(grep -a "$pat" "$LOG-$s.log" | tail -1 | cut -c1-200)
        [ $rc -eq 0 ] && [ -n "$d" ] && verdict "$s" PASS "$d" || verdict "$s" FAIL "rc $rc$(capnote $rc); ${d:-no count line}; $LOG-$s.log"; }
    # tms6747.sh, shards $5 (a-b) of NSHARD: $1 the verdict's name, $2 flags, $3 SIM, $4 the walker's switch or nothing
    NSHARD=6
    tms() { s=$1; p=0; f=0; bad=; r=$5; [ "${s%@*}" = tms2 ] && : > "$LOG-cycles.txt"
        for h in $(seq "${r%-*}" "${r#*-}"); do
            job 1500 env $4 SHARD=$h/$NSHARD CXX1_FLAGS=$2 CYCLES=1 SIM=$3 sh tests/tms6747.sh > "$LOG-$s-$h.log" 2>&1; rc=$?
            l=$(grep -a '^tms6747.sh: [0-9]* passed, [0-9]* failed' "$LOG-$s-$h.log" | tail -1)
            if [ -z "$l" ]; then bad="$bad shard $h: no count, rc $rc$(capnote $rc);"; continue; fi
            set -- "$1" "$2" "$3" "$4" "$5" $(echo "$l" | sed 's/^tms6747.sh: \([0-9]*\) passed, \([0-9]*\) failed.*/\1 \2/')
            p=$((p + $6)); f=$((f + $7)); [ $rc -eq 0 ] || bad="$bad shard $h: rc $rc$(capnote $rc);"
            [ "${s%@*}" = tms2 ] && cat tests/out-tms6747/cycles.txt >> "$LOG-cycles.txt"
        done
        d="tms6747.sh ${2:--O0}${4:+ walker} SIM=$3 shards $r/$NSHARD: $p passed, $f failed"
        [ -z "$bad" ] && [ $f -eq 0 ] && verdict "$s" PASS "$d" || verdict "$s" FAIL "$d;$bad $LOG-$s-*.log"; }
    # the fixed point at $2: stages "0 1", 2, 3 as box jobs, a cut stage resumed twice
    fixed() { s=$1; o=$HOME/$N-$s; : > "$LOG-$s.log"
        for st in 0 1 2 3; do res=
            for try in 1 2 3; do job 1500 env SELFHOST_JOBS=2 SELFHOST_RESUME=$res sh tools/self-host "$o" "$2" "$st" >> "$LOG-$s.log" 2>&1; [ $? -eq 124 ] || break; res=1; done
        done
        a=$(grep -a 'the same object from stages 0, 1 and 2' "$LOG-$s.log" | tail -1); b=$(grep -a 'the same object from stages 2 and 3' "$LOG-$s.log" | tail -1)
        n=$(find src -name "*.cpp" | wc -l | tr -d " ")
        case "$a|$b" in "self-host: $n of $n "*"|self-host: $n of $n "*) verdict "$s" PASS "${2:--O0}: $n of $n the same from stages 0, 1, 2 and from 2, 3" ;;
            *) verdict "$s" FAIL "${2:--O0}: ${a:-stages 0-2 not compared}; ${b:-stages 2-3 not compared}; $LOG-$s.log" ;; esac; }
    # $1 the step's "<case> <target> <level>" differences, $2 its targets, $3 its one level (emit: -O2, where a named row the same is identical's to judge, not a FAIL): against tests/wave-expected.txt's rows (N2)
    against() { sed -n 's/^\([^# ][^ ]*\) \([^ ]*\) \([0-9s]\) ..*/\1 \2 \3/p' tests/wave-expected.txt 2>/dev/null |
            awk -v t=" $2 " -v l="${3:-}" 'index(t, " " $2 " ") && (l == "" || $3 == l)' | sort -u > "$1.want"; sort -u "$1" > "$1.got"
        u=$(comm -23 "$1.got" "$1.want" | tr '\n' ',' | cut -c1-160); m=$(comm -13 "$1.got" "$1.want" | tr '\n' ',' | cut -c1-160)
        echo "$(wc -l < "$1.got" | tr -d ' ') differ, $(comm -12 "$1.got" "$1.want" | wc -l | tr -d ' ') named in tests/wave-expected.txt${u:+; NOT NAMED: $u}${m:+; named and the same: $m}"
        [ -z "$u" ] && { [ -n "${3:-}" ] || [ -z "$m" ]; }; }
    # tools/identical.sh at -O0, -O1, -O2 over $2 against the base's build: a difference passes only where named
    ident() { s=$1; ref=$T-base/cxx3.exe
        [ -x "$ref" ] || { verdict "$s" FAIL "no base build at $ref (-w <commit> names the wave's base)"; return; }
        job 1500 env ARCHS="$2" LEVELS="0 1 2" JOBS=2 sh tools/identical.sh "$ref" "$T/cxx3.exe" /none "$LOG-$s" > "$LOG-$s.log" 2>&1; rc=$?
        l=$(grep -a '^identical: ' "$LOG-$s.log" | tail -1)
        sed -n 's/^DIFFERS tests_cases_\([^ .]*\(\.part\)\{0,1\}\)\.\([^ ]*\)\.O\([0-9s]\) .*/\1 \3 \4/p' "$LOG-$s.log" |
            sed 's/ linux / x86_64-linux /; s/ win\.gnu / x86_64-windows /; s/ win\.masm / x86_64-windows /' > "$LOG-$s.diff"
        a=$(against "$LOG-$s.diff" "$2"); ok=$?
        [ -n "$l" ] && [ $rc -le 1 ] && [ $ok -eq 0 ] && verdict "$s" PASS "$l against the base; $a" ||
            verdict "$s" FAIL "rc $rc$(capnote $rc); ${l:-no count line}; $a; $LOG-$s.log"; }
    [ "${1:-}" = build ] || cd "$T" || exit 2
    [ "$B" = linux ] && export JOBS=2
    step1() { s=$1; R=$(echo "$s" | sed -n 's/.*@//p'); R=${R:-1-$NSHARD}       # step@a-b: shards a to b of six
        echo "wave-gate: $B $s starts $(date +%H:%M:%S)"
        # Linux's steps that run make (self-host's stage 0, make test) beside steps running cxx3.exe: make must be a no-op
        case $B:$s in linux:selfc|linux:fixed*|linux:maketest) make -q cxx3.exe > /dev/null 2>&1 || {
            verdict "$s" FAIL "make -q cxx3.exe: out of date in $T - this step's make would relink it under the steps running it"
            echo "wave-gate: $B $s ends $(date +%H:%M:%S)"; return; };; esac
        case $s in
        build) rm -rf "$T" "$T-base" && mkdir -p "$T/tmp" && tar -C "$T" -xzf "$HOME/$N-tree.tgz" && cd "$T" || { verdict build FAIL "no tree from ~/$N-tree.tgz"; exit 1; }
            bp=; bm="no base named (-w)"     # the wave's base, built beside it in the other slot (N2)
            if [ -f "$HOME/$N-base-tree.tgz" ]; then mkdir -p "$T-base" && tar -C "$T-base" -xzf "$HOME/$N-base-tree.tgz" &&
                (cd "$T-base" && job 540 make -j2 cxx3.exe > "$LOG-basebuild.log" 2>&1) & bp=$!; fi
            job 540 make -j2 cxx3.exe > "$LOG-build.log" 2>&1; rc=$?
            if [ -n "$bp" ]; then wait $bp && bm="the base $(cat "$HOME/$N-base-commit" 2>/dev/null) built in $T-base" || bm="the base did not build: $LOG-basebuild.log"; fi
            if [ $rc -eq 0 ]; then verdict build PASS "cxx3.exe built by $(g++ --version | head -1); $bm"
            else verdict build FAIL "$(grep -a -m1 'error' "$LOG-build.log" | cut -c1-160); $LOG-build.log"; exit 1; fi ;;
        static) d=; ok=1
            for c in "python3 tools/exclusions --check docs/EXCLUSIONS.md" "make comments" "python3 tools/memory-gate --check" "python3 ide/generate.py --check"; do
                job 540 $c > "$LOG-static.log" 2>&1; rc=$?; l=$(grep -av '^slot [12]: ' "$LOG-static.log" | tail -1 | cut -c1-90); [ $rc -eq 0 ] || { ok=0; l="FAILED ($c): $l"; }; d="$d${d:+ | }$l"; done
            [ $ok = 1 ] && verdict static PASS "$d" || verdict static FAIL "$d" ;;
        maketest) job 1500 env JOBS=2 make test > "$LOG-maketest.log" 2>&1; rc=$?
            d=$(grep -a '^[a-z0-9.-]*\.sh: .*[0-9] \(passed\|changed\|failed\)' "$LOG-maketest.log" | sed 's/ (.*//; s/, [0-9]* \(skipped\|were\|printed\).*//' | tr '\n' ';' | cut -c1-400)
            [ $rc -eq 0 ] && verdict maketest PASS "rc 0; $d" || verdict maketest FAIL "rc $rc$(capnote $rc); $d $LOG-maketest.log" ;;
        subst) if [ -f tests/subst.sh ]; then suite subst '^subst.sh: ' env JOBS=2 sh tests/subst.sh     # R109, lane r6f: -templates=subst on against off
            else verdict subst "NOT RUN" "tests/subst.sh is not in this tree (R109, lane r6f)"; fi ;;
        run1) suite run1 '^run.sh: ' env CXX1="./cxx3.exe -O1" sh tests/run.sh ;;
        run2) suite run2 '^run.sh: ' env CXX1="./cxx3.exe -O2" sh tests/run.sh ;;     # N3: x86_64-linux code at -O2
        ssa1|ssa2) suite "$s" '^ssa.sh: [0-9]* passed' env SSA_LEVEL=${s#ssa} JOBS=2 CXX1=./cxx3.exe sh tests/ssa.sh ;;
        tms0*) tms "$s" "" 0 "" "$R" ;;   tms1*) tms "$s" -O1 0 "" "$R" ;;   tms2*) tms "$s" -O2 0 "" "$R" ;;
        wtms0*) tms "$s" "" 0 CXX1_C6X_WALKER=1 "$R" ;;   wtms1*) tms "$s" -O1 0 CXX1_C6X_WALKER=1 "$R" ;;   wtms2*) tms "$s" -O2 0 CXX1_C6X_WALKER=1 "$R" ;;
        sim*) if [ -x "$SIM6747" ]; then tms "$s" -O2 1 "" "$R"; else verdict "$s" "NOT RUN" "sim6747 is not built on this box ($SIM6747)"; fi ;;
        cycles) if [ ! -f tools/c6x-cycles ]; then verdict cycles "NOT RUN" "tools/c6x-cycles is not in this tree (R106)"
            elif [ ! -s "$LOG-cycles-joined.txt" ]; then verdict cycles "NOT RUN" "no joined cycles.txt came from tms2's shards"
            else job 1500 sh tools/c6x-cycles --check "$LOG-cycles-joined.txt" > "$LOG-cycles.log" 2>&1; rc=$?
                d=$(grep -a ' cases, [0-9]* in the baseline' "$LOG-cycles.log" | tail -1 | cut -c1-200)
                # a WORSE case passes only through an owed or accepted line in tests/tms6747-cycles.txt (accepting a cycle is the user's): a
                # tests/wave-expected.txt row names an output difference and never accepts a cycle; missing or stale never pass
                grep -a '^  WORSE ' "$LOG-cycles.log" | awk '{ print $2 " tms6747 2" }' > "$LOG-cycles.diff"
                u=$(sort -u "$LOG-cycles.diff" | tr '\n' ',' | cut -c1-160)
                o=$(grep -a -c '^  \(MISSING\|STALE\) ' "$LOG-cycles.log")
                if [ -n "$d" ] && [ -z "$u" ] && [ "$o" = 0 ] && [ $rc -eq 0 ]
                then verdict cycles PASS "$d; every worse case owed or accepted in tests/tms6747-cycles.txt"
                else verdict cycles FAIL "rc $rc$(capnote $rc); ${d:-no count line}${u:+; WORSE, neither owed nor accepted: $u}; $o missing or stale; $LOG-cycles.log"; fi; fi ;;
        identical) ident identical tms6747 ;;   identlnx) ident identlnx x86_64-linux ;;     # N2, N3
        identwin) ident identwin x86_64-windows ;;   identa64) ident identa64 arm64-darwin ;;
        emit) b=$T-base     # N5: the golden is the base's, recorded in this run; no golden is a FAIL
            if [ ! -x "$b/cxx3.exe" ]; then verdict emit FAIL "no base build at $b (-w <commit>): no golden to compare against"
            else (cd "$b" && job 1500 sh tests/emit.sh --o2 --record) > "$LOG-emit-base.log" 2>&1
                rm -rf tests/out-emit-O2.golden; cp -R "$b/tests/out-emit-O2.golden" tests/ 2>/dev/null
                if [ ! -f tests/out-emit-O2.golden/RECORDED ]; then verdict emit FAIL "the base recorded no golden; $LOG-emit-base.log"
                else job 1500 sh tests/emit.sh --o2 > "$LOG-emit.log" 2>&1; rc=$?; l=$(grep -a '^emit.sh: golden - ' "$LOG-emit.log" | tail -1)
                    for f in tests/out-emit-O2/*.tms6747.s; do g=tests/out-emit-O2.golden/${f##*/}; [ -f "$g" ] && ! cmp -s "$f" "$g" &&
                        echo "$(basename "$f" .tms6747.s) tms6747 2"; done > "$LOG-emit.diff"
                    a=$(against "$LOG-emit.diff" tms6747 2); ok=$?
                    [ $rc -eq 0 ] && [ -n "$l" ] && [ $ok -eq 0 ] && verdict emit PASS "${l#emit.sh: } against the base's golden; $a" ||
                        verdict emit FAIL "rc $rc$(capnote $rc); ${l:-no count line}; $a; $LOG-emit.log"; fi; fi ;;
        census) # N1: ssa-census's own status, walked at -O2 (with outside=) and at -O0, against tools/c6x-walked.baseline
            job 1500 env CENSUS_FLAGS=-O2 CENSUS_JOBS=$JOBS sh tools/ssa-census -arch tms6747 "${CXX1:-./cxx3.exe}" "$LOG-census" > "$LOG-census.log" 2>&1; rc=$?
            job 1500 env CENSUS_SOURCES=0 CENSUS_FLAGS= CENSUS_JOBS=$JOBS sh tools/ssa-census -arch tms6747 "${CXX1:-./cxx3.exe}" "$LOG-census0" > "$LOG-census0.log" 2>&1; r0=$?
            o=$(grep -a '^ssa-census tms6747: outside=' "$LOG-census.log" | tail -1 | sed 's/ of .* other/; other/')
            w=$(cat "$LOG-census.log" "$LOG-census0.log" | sed -n 's/^ssa-census tms6747 \(-O[0-9]\): walked \([0-9]*\) functions.*; baseline \(.*\)/\1 walked \2 (baseline \3)/p' | tr '\n' ';')
            r=$(cat "$LOG-census.log" "$LOG-census0.log" | grep -a -c 'walked count rose')
            [ $rc -eq 0 ] && [ $r0 -eq 0 ] && [ -n "$o" ] && [ "$(echo "$w" | tr -cd ';' | wc -c)" -eq 2 ] && verdict census PASS "$o; $w" ||
                verdict census FAIL "rc $rc/$r0$(capnote $rc)$(capnote $r0); ${o:-no outside= line}; ${w:-no walked line}; $r above the baseline; $LOG-census.log" ;;
        asm0) suite asm0 '^asm6x.sh: ' env CXX1_FLAGS= sh tests/asm6x.sh ;;
        asm1) suite asm1 '^asm6x.sh: ' env CXX1_FLAGS=-O1 sh tests/asm6x.sh ;;     # r6e: ssa-layout's wrong instruction was -O1's alone
        asm2) suite asm2 '^asm6x.sh: ' env CXX1_FLAGS=-O2 sh tests/asm6x.sh ;;
        declines) if [ -f tools/c6x-declines ]; then suite declines '^c6x-declines: ' env CXX1="${CXX1:-./cxx3.exe}" sh tools/c6x-declines --check
            else verdict declines "NOT RUN" "tools/c6x-declines is not in this tree (R108, lane r6e)"; fi ;;
        gdb) suite gdb '^debug.sh gdb' sh tests/debug.sh gdb ./cxx3.exe ;;
        selfc) res=; : > "$LOG-selfc.log"
            for try in 1 2 3; do job 1500 env SELFHOST_RESUME=$res sh tools/self-host "$HOME/$N-selfc" "" 0 >> "$LOG-selfc.log" 2>&1; rc=$?; [ $rc -eq 124 ] || break; res=1; done
            d=$(grep -a 'stage 0 compiled' "$LOG-selfc.log" | tail -1)
            case "$d" in *" compiled "*) set -- $(echo "$d" | sed 's/.*compiled \([0-9]*\) of \([0-9]*\) .*/\1 \2/'); [ "$1" = "$2" ] && verdict selfc PASS "$d" || verdict selfc FAIL "$d; $LOG-selfc.log" ;;
                *) verdict selfc FAIL "rc $rc$(capnote $rc); no count; $LOG-selfc.log" ;; esac ;;
        fixed0) fixed fixed0 "" ;;   fixed2) fixed fixed2 -O2 ;;
        *) verdict "$s" FAIL "wave-gate --box knows no step $s" ;;
        esac
        echo "wave-gate: $B $s ends $(date +%H:%M:%S)"; }
    # Linux: the build alone, then two steps at once, a slot each; Windows: one step a call (the Mac's pool)
    if [ "${1:-}" = build ]; then step1 build; shift; fi
    if [ "$B" = linux ]; then lwid() { echo 1; }
        pool "${WAVEGATE_SLOTS:-2}" step1 lwid - "$@"
    else for s in "$@"; do step1 "$s"; done; fi
    echo CHAIN-DONE >> "$V"; exit 0
fi


# ---- the Mac's side
ROOT=$(cd "$(dirname "$0")/.." && pwd)
N=${1:?usage: tools/wave-gate <name> [-n step,...=reason]... [-b linux,windows,mac] [-B step=box,...] [-t commit] [-r]}; shift
case $N in -*|*[!A-Za-z0-9_-]*) echo "wave-gate: <name> is letters, digits, - and _: it names a folder on each box" >&2; exit 2;; esac
KEY=${CXX1_LINUX_KEY:-$HOME/Documents/Claude/myMorningWalk.pem}
LINUX=${CXX1_LINUX:-ec2-user@52.202.164.123}
WINDOWS=${WINDOWS_BOX:-windows}; WORK=${CXX1_WINDOWS_WORK:-'C:\Users\GRA\work'}; REMOTE="$WORK\\$N"; WF=$(printf '%s' "$WORK" | tr '\\' '/')
WINBASH=${CXX1_WINDOWS_BASH:-'C:\Program Files\Git\bin\bash.exe'}; WINPY=${CXX1_WINDOWS_PYTHON:-'C:\Program Files\Python312\python.exe'}
OUT=${WAVEGATE_OUT:-$HOME/cxxopt-build/wave-gate}/$N
MACDIR=${WAVEGATE_MAC:-$HOME/cxxopt-build}/$N
BOXES="linux windows mac"; REPORT=; PLAN=; KEEP=; ASKED=; COMMIT=HEAD; OVER=${WAVEGATE_BOXES:-}; BASE=${WAVEGATE_BASE:-}; MILESTONE=
WHY=$(mktemp); trap 'rm -f "$WHY"' EXIT
ALL=$(for r in $BOXTAB; do printf '%s ' "${r%%=*}"; done)
while [ $# -gt 0 ]; do
    case $1 in
    -n) case ${2:-} in *=?*) ;; *) echo "wave-gate: -n wants <step>[,<step>]=<reason>" >&2; exit 2;; esac
        printf '%s\t%s\n' "${2%%=*}" "${2#*=}" >> "$WHY.g"; shift 2 ;;
    -b) BOXES=$(echo "${2:?-b wants boxes}" | tr ',' ' '); shift 2 ;;
    -B) OVER="$OVER $(echo "${2:?-B wants step=box}" | tr ',' ' ')"; shift 2 ;;
    -t) COMMIT=${2:?-t wants a commit}; shift 2 ;;
    -r) REPORT=1; shift ;;
    -p) PLAN=1; shift ;;
    -k) KEEP=1; shift ;;
    -w) BASE=${2:?-w wants the base commit of the wave}; shift 2 ;;
    -m) MILESTONE=${2:?-m wants the milestone that closes}; shift 2 ;;
    -a) case " $STEPS_asked " in *" ${2:-} "*) ASKED="$ASKED $2"; OVER="$OVER $2=mac";; *) echo "wave-gate: -a takes one of: $STEPS_asked" >&2; exit 2;; esac; shift 2 ;;
    *) echo "wave-gate: unknown argument $1" >&2; exit 2 ;;
    esac
done
for o in $OVER; do case ${o#*=} in linux|windows|mac|split|idle) ;; *) echo "wave-gate: -B $o: a box is linux, windows, mac, split or idle" >&2; exit 2;; esac; done
boxof() { b=; for r in $BOXTAB $OVER; do [ "${r%%=*}" = "$1" ] && b=${r#*=}; done; echo "$b"; }   # the last row for a step wins
STEPS="$ALL$ASKED"
group() { case $1 in tms) echo "tms0 tms1 tms2";; wtms) echo "wtms0 wtms1 wtms2";; winpass) echo "winpass0 winpass1 winpass2";;
    fixed) echo "fixed0 fixed2 wfixed0 wfixed2";; linux|windows|mac|split|idle) for s in $STEPS; do [ "$(boxof $s)" = $1 ] && printf '%s ' $s; done;;
    *) echo "$1";; esac; }
if [ -f "$WHY.g" ]; then while IFS="$(printf '\t')" read -r g r; do for g1 in $(echo "$g" | tr ',' ' '); do for s in $(group "$g1"); do
    case $s in fixed0|fixed2|wfixed0|wfixed2) echo "wave-gate: -n $s: the script decides whether the fixed point is owed (-m makes it owed)" >&2; rm -f "$WHY.g"; exit 2;; esac
    case " $STEPS " in *" $s "*) printf '%s\t%s\n' "$s" "$r" >> "$WHY";; *) echo "wave-gate: no step $s" >&2; rm -f "$WHY.g"; exit 2;; esac
    done; done; done < "$WHY.g"; rm -f "$WHY.g"; fi
[ -z "$BASE" ] || BASE=$(git -C "$ROOT" rev-parse --short=8 "$BASE") || exit 2
# N4: the fixed point is owed at a milestone's close, or when base..commit adds or deletes a src/ file or takes 100
# src/ lines away net; otherwise its four steps are NOT RUN with this check as the reason, never with a typed one
owed() { [ -n "$MILESTONE" ] && { echo "$MILESTONE closes (-m)"; return; }
    [ -n "$BASE" ] || { echo "no base named (-w), so a deleted path cannot be ruled out"; return; }
    f=$(git -C "$ROOT" diff --name-only --diff-filter=AD "$BASE" "$COMMIT" -- src | head -3 | tr '\n' ' ')
    [ -n "$f" ] && { echo "src/ files added or deleted from $BASE: $f"; return; }
    n=$(git -C "$ROOT" diff --numstat "$BASE" "$COMMIT" -- src | awk '{ d += $2 - $1 } END { print d + 0 }')
    [ "$n" -ge 100 ] && echo "src/ lost $n lines net from $BASE"; }
FIXED_OWED=$(owed)
[ -n "$FIXED_OWED" ] || for s in fixed0 fixed2 wfixed0 wfixed2; do
    printf '%s\tnot owed (checked): no milestone close (-m), no src/ file added or deleted, under 100 src/ lines away net from %s to %s\n' "$s" "$BASE" "$(git -C "$ROOT" rev-parse --short=8 "$COMMIT")" >> "$WHY"; done
why() { awk -F'\t' -v s="$1" '$1 == s { print $2; exit }' "$WHY"; }
done_() { [ -n "$KEEP" ] && cat "$OUT"/*.verdicts 2>/dev/null | awk -F'\t' -v s="$1" '$1 == s { f = 1 } END { exit !f }'; }   # -k: a step with a verdict is not run again
has() { case " $BOXES " in *" $1 "*) return 0;; esac; return 1; }
# a box's list: its build, then its half of every split step (both halves at once on the two boxes), then its own
legsteps() { b=$1; r=SPLIT_$(echo $b | tr a-z A-Z); eval "r=\${$r:-}"; l=
    for s in $STEPS; do x=$(boxof $s); [ -z "$(why $s)" ] || continue
        if [ "$x" = split ] && [ -n "$r" ] && { [ -n "${WAVEGATE_HALVES:-}" ] || { has linux && has windows; }; }; then p="$s@$r"   # HALVES: one box's half alone
        elif [ "$x" = split ] && [ -n "$r" ]; then p="$s@1-$NSHARD"           # one box asked: it takes all six
        elif [ "$x" = "$b" ] && [ $s != cycles ]; then p=$s; else continue; fi     # cycles: after the join (own())
        done_ "$p" || l="$l $p"; done
    for p in $l; do case $p in build|wbuild|mbuild) printf '%s ' $p;; esac; done
    for p in $l; do case $p in *@*) printf '%s ' $p;; esac; done
    for p in $l; do case $p in build|wbuild|mbuild|*@*) ;; *) printf '%s ' $p;; esac; done; }
mkdir -p "$OUT"; TAB=$(printf '\t')
verdict() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$OUT/$4.verdicts"; }
capped() { c=$1; shift; perl -e 'alarm shift; exec @ARGV' "$c" "$@"; }
lssh() { ssh -i "$KEY" -o BatchMode=yes -o ConnectTimeout=20 "$LINUX" "$@"; }
wdisk() { capped 60 ssh -o BatchMode=yes "$WINDOWS" 'powershell -NoProfile -Command "$d = Get-PSDrive C; [int](100 * $d.Used / ($d.Used + $d.Free))"' 2>/dev/null | tr -dc 0-9; }
# a Windows verdict written here: a PASS while the box is above 70% full is a FAIL (the user's limit)
wverdict() { u=$(wdisk); if [ "$2" = PASS ] && [ "${u:-0}" -gt 70 ]; then verdict "$1" FAIL "disk $u% on the Windows box, over 70%; $3" windows; else verdict "$1" "$2" "$3" windows; fi; }
# an idle step for box $1: the first unclaimed one, claimed by an atomic mkdir; cycles waits for both halves of tms2
claim() { for s in $(group idle); do
        [ -z "$(why $s)" ] && ! done_ $s && mkdir "$OUT/claim/$s" 2>/dev/null && { echo "$s $1" >> "$OUT/chose"; echo $s; return; }; done; }
# a verdict the Mac writes for box $1: Linux's goes into the box's file too, which each poll copies over the Mac's
bverdict() { [ $1 = linux ] && printf '%s\t%s\t%s\n' "$2" "$3" "$4" | lssh "cat >> ~/$N-verdicts.txt"; verdict "$2" "$3" "$4" $1; }
cycles_join() {   # $1 the box that runs the check: both boxes' tms2 cycles.txt, one file, there; cj_ names its own
    cj_t=0; while :; do cj_n=0     # (w21g: a shared t made linux_leg's chain "asm2 240", and cycles lost its verdict)
        for cj_f in linux windows; do awk -F'\t' '$1 ~ /^tms2(@|$)/ { f = 1 } END { exit !f }' "$OUT/$cj_f.verdicts" 2>/dev/null && cj_n=$((cj_n + 1)); done
        cj_w=0; has linux && cj_w=$((cj_w + 1)); has windows && cj_w=$((cj_w + 1)); [ "$(boxof tms2)" = split ] || cj_w=1; [ $cj_n -ge $cj_w ] && break
        [ $cj_t -ge 3600 ] && { bverdict $1 cycles "NOT RUN" "tms2's halves: $cj_n of $cj_w reported within an hour, nothing to join"; return 1; }
        sleep 60; cj_t=$((cj_t + 60)); done
    : > "$OUT/cycles-joined.txt"
    has linux && lssh "cat ~/$N-cycles.txt 2>/dev/null" >> "$OUT/cycles-joined.txt"
    has windows && ssh -o BatchMode=yes "$WINDOWS" "type $WORK\\$N-cycles.txt 2>nul" | tr -d '\r' >> "$OUT/cycles-joined.txt"
    sort -o "$OUT/cycles-joined.txt" "$OUT/cycles-joined.txt"
    # the judge and its baseline go with it: R106's, from this script's tree, when the gated commit predates them
    if [ $1 = linux ]; then scp -q -i "$KEY" -o BatchMode=yes "$OUT/cycles-joined.txt" "$LINUX:$N-cycles-joined.txt"
        [ -f "$WT/tools/c6x-cycles" ] || scp -q -i "$KEY" -o BatchMode=yes "$ROOT/tools/c6x-cycles" "$ROOT/tests/tms6747-cycles.txt" "$LINUX:$N/tools/"
        [ -f "$WT/tools/c6x-cycles" ] || lssh "mv ~/$N/tools/tms6747-cycles.txt ~/$N/tests/"
    else scp -q -o BatchMode=yes "$OUT/cycles-joined.txt" "$WINDOWS:$WF/$N-cycles-joined.txt"
        [ -f "$WT/tools/c6x-cycles" ] || { scp -q -o BatchMode=yes "$ROOT/tools/c6x-cycles" "$WINDOWS:$WF/$N/tools/c6x-cycles"
            scp -q -o BatchMode=yes "$ROOT/tests/tms6747-cycles.txt" "$WINDOWS:$WF/$N/tests/tms6747-cycles.txt"; }; fi; }

own() { [ "$(boxof cycles)" = $1 ] && [ -z "$(why cycles)" ] && ! done_ cycles && cycles_join $1 && echo cycles; }   # cycles on a box by -B
linux_chain() {   # the steps as one detached chain on the box, polled once a minute
    lssh "sed -i /^CHAIN-DONE/d ~/$N-verdicts.txt 2>/dev/null; nohup sh ~/$N-wave-gate --box linux $N $* > ~/$N-gate.out 2>&1 < /dev/null & echo started \$!" > "$OUT/linux.pid"
    pid=$(awk "{print \$2}" "$OUT/linux.pid"); polls=0; echo "wave-gate: linux $* (pid $pid) $(date +%H:%M)"
    while [ $polls -lt 900 ]; do sleep 60; polls=$((polls + 1))
        a=$(lssh "kill -0 $pid 2>/dev/null && echo alive || echo ended")
        lssh "cat ~/$N-verdicts.txt" > "$OUT/linux.poll" 2>/dev/null && cp "$OUT/linux.poll" "$OUT/linux.verdicts"
        [ "$a" = ended ] && break
    done; }
linux_leg() {
    [ -n "$KEEP" ] || { : > "$OUT/linux.verdicts"; lssh "rm -f ~/$N-verdicts.txt ~/$N-cycles.txt"; }
    scp -q -i "$KEY" -o BatchMode=yes "$OUT/tree.tgz" "$LINUX:$N-tree.tgz" && scp -q -i "$KEY" -o BatchMode=yes "$ROOT/tools/wave-gate" "$LINUX:$N-wave-gate" ||
        { verdict build FAIL "the tree did not reach $LINUX" linux; return; }
    if [ -s "$OUT/base.tgz" ]; then scp -q -i "$KEY" -o BatchMode=yes "$OUT/base.tgz" "$LINUX:$N-base-tree.tgz" && lssh "echo $BASE > ~/$N-base-commit"
    else lssh "rm -f ~/$N-base-tree.tgz ~/$N-base-commit"; fi
    # ~/slot is this script's SLOT: installed when missing, and a copy that differs is named, not overwritten
    h=$(lssh 'cat ~/slot 2>/dev/null'); if [ -z "$h" ]; then printf '%s\n' "$SLOT" | lssh 'cat > ~/slot.new && chmod +x ~/slot.new && mv ~/slot.new ~/slot' && echo "wave-gate: ~/slot installed on $LINUX"
    elif [ "$h" != "$SLOT" ]; then echo "wave-gate: ~/slot on $LINUX differs from this script's SLOT - the box's copy runs"; fi
    free=$(lssh "df -BG --output=avail ~ | tail -1 | tr -dc 0-9")
    [ "${free:-0}" -ge 3 ] || { verdict build FAIL "the Linux box has ${free:-?} GB free, under 3" linux; return; }
    st=$(legsteps linux); [ -n "$st" ] && linux_chain $st
    grep -q "^build${TAB}PASS" "$OUT/linux.verdicts" 2>/dev/null || return 0
    s=$(own linux); [ -n "$s" ] && { linux_chain cycles; lost cycles; }
    # idle steps two at a time, one chain: the box's pool puts them in the two slots; cycles once its join is there
    while s=$(claim linux); [ -n "$s" ]; do t=; [ $s = cycles ] || t=$(claim linux); c=
        for x in $s $t; do [ $x = cycles ] && ! cycles_join linux && continue; c="$c $x"; done
        [ -n "$c" ] && { linux_chain $c; lost $c; }; done; }
# a step the chain ran that left no verdict on the box fails by name, never as a NOT RUN with no reason
lost() { for x in "$@"; do awk -F'\t' -v s="$x" '$1 == s { f = 1 } END { exit !f }' "$OUT/linux.verdicts" 2>/dev/null ||
    bverdict linux "$x" FAIL "the Linux chain ended with no verdict for it; ~/$N-gate.out"; done; }

windows_step() { s=$1; LN=${2:-${WINLANES:-10}}; L="$OUT/$s.log"; W="$ROOT/tools/windows"
    case $s in
    wbuild) sh "$W/winbuild.sh" "$WT" "$N" > "$L" 2>&1 && scp -q -o BatchMode=yes "$ROOT/tools/wave-gate" "$WINDOWS:$WF/$N/tools/wave-gate" &&   # a commit before r6a has none
            wverdict wbuild PASS "cxx3-msvc.exe built by cl /W4 /WX" || { verdict wbuild FAIL "$(tail -1 "$L" | cut -c1-160); $L" windows; return 1; } ;;
    winpass[012]) f=-O${s#winpass}
        NOBUILD=1 WINLANES=$LN sh "$W/winpass.sh" "$WT" "$N" "$f" > "$L" 2>&1
        d=$(grep -a 'same, [0-9]* differ' "$L" | sed 's/^.*\\winout/winout/' | tr '\n' ';' | cut -c1-300)
        if [ "$(grep -a -c ' same, 0 differ; .* 0 not; 0 compile-failed, 0 not run' "$L")" = 2 ] && ! grep -a -q CAPPED "$L"
        then wverdict "$s" PASS "$f $d"; else verdict "$s" FAIL "$f ${d:-no verdict line}$(grep -a -m1 CAPPED "$L"); $L" windows; fi ;;
    cdb) d=; ok=1
        for sp in masm gnu; do
            l=$(capped 600 ssh -o BatchMode=yes "$WINDOWS" "cd /d $REMOTE && set CPP11_LD=$REMOTE\\winout-tools\\link.exe&& set DEBUG_FLAGS=-masm=$sp&& start \"\" /b /wait /affinity 3FF \"$WINBASH\" tests/debug.sh cdb ./cxx3-msvc.exe" 2>&1 | tr -d '\r' | tee -a "$L" | tail -1)
            case "$l" in "debug.sh cdb"*" 0 failed") ;; *) ok=0;; esac; d="$d${d:+; }${l:-no line at -masm=$sp}"; done
        [ $ok = 1 ] && wverdict cdb PASS "$d" || verdict cdb FAIL "$d; $L" windows ;;
    wselfc) d=$(capped 1500 ssh -o BatchMode=yes "$WINDOWS" "start \"\" /b /wait /affinity 3FF cmd /c $REMOTE\\tools\\windows\\self-compile.cmd $REMOTE" 2>&1 | tr -d '\r' | tee "$L" | grep '^self-compile.cmd: ' | tail -1)
        set -- $(echo "$d" | sed -n 's/^self-compile.cmd: \([0-9]*\) of \([0-9]*\) .*/\1 \2/p')
        [ -n "${1:-}" ] && [ "$1" = "$2" ] && wverdict wselfc PASS "$d" || verdict wselfc FAIL "${d:-no count}; $L" windows ;;
    release) # N5: the box half of release-check, under the cap; its ssh can outlive the verdict line, so that ends it
        capped 1500 ssh -o BatchMode=yes "$WINDOWS" "cd /d $REMOTE && start \"\" /b /wait /affinity 3FF \"$WINPY\" -u tools\\c6747\\release-check-box.py $REMOTE $REMOTE\\cxx3-msvc.exe $WORK\\ti6x\\ASM6x\\build\\asm6x.exe $WORK\\ti6x\\VM6747\\vm6747.exe" > "$L" 2>&1 & rp=$!
        while kill -0 $rp 2>/dev/null; do grep -a -q '^release-check-box: \(PASS\|FAIL\) in ' "$L" && { sleep 5; kill $rp 2>/dev/null; break; }; sleep 15; done; wait $rp 2>/dev/null
        d=$(tr -d '\r' < "$L" | grep -a '^release-check-box: ' | tail -1 | cut -c1-200)
        case "$d" in *": PASS in "*) wverdict release PASS "$d";; *) verdict release FAIL "${d:-no line from release-check-box.py}; $L" windows;; esac ;;
    names|overload|winstruct) u=$s; [ $s = winstruct ] && u=win-structure
        capped 1500 ssh -o BatchMode=yes "$WINDOWS" "cd /d $REMOTE && start \"\" /b /wait /affinity 3FF \"$WINBASH\" tools/wave-gate --suite $u" > "$L" 2>&1
        d=$(tr -d '\r' < "$L" | grep -a "^$u.sh: \|^wave-gate: no " | tail -2 | tr '\n' ';' | cut -c1-300)
        if tr -d '\r' < "$L" | grep -a -q "^wave-gate: $u.sh rc 0$" && [ -n "$d" ] && ! grep -a -q "^$u.sh: skipped\|NOT RUN" "$L"
        then wverdict "$s" PASS "$d"; else verdict "$s" FAIL "${d:-no count line}; $L" windows; fi ;;
    wfixed[02]) f=; [ $s = wfixed2 ] && f=-O2
        sh "$W/self-host-stages.sh" "$N" "$f" > "$L" 2>&1
        a=$(grep -a 'the same object from stages 0, 1 and 2' "$L" | tail -1); b=$(grep -a 'the same object from stages 2 and 3' "$L" | tail -1)
        n=$(echo "$a" | sed -n 's/.* \([0-9]*\) of \([0-9]*\) sources.*/\1 \2/p'); m=$(echo "$b" | sed -n 's/.* \([0-9]*\) of \([0-9]*\) sources.*/\1 \2/p')
        if [ -n "$n" ] && [ -n "$m" ] && [ "${n% *}" = "${n#* }" ] && [ "${m% *}" = "${m#* }" ]
        then wverdict "$s" PASS "${f:--O0} masm: $a; $b"; else verdict "$s" FAIL "${f:--O0}: ${a:-stages 0-2 not compared}; ${b:-stages 2-3 not compared}; $L" windows; fi ;;
    *)  # the C6000 and the -S comparisons, by this file's --box side in the built tree (it checks the disk itself)
        capped 9200 ssh -o BatchMode=yes "$WINDOWS" "cd /d $REMOTE && set WINLANES=$LN&& set JOBS=$LN&& start \"\" /b /wait /affinity 3FF \"$WINBASH\" tools/wave-gate --box windows $N $s" > "$L" 2>&1
        v=$(tr -d '\r' < "$L" | awk -F'\t' '$1 == "VERDICT" { print $3 "\t" $4 }' | tail -1)
        [ -n "$v" ] && printf '%s\t%s\n' "$s" "$v" >> "$OUT/windows.verdicts" || verdict "$s" FAIL "no verdict came back; $L" windows ;;
    esac; }
windows_leg() {
    [ -n "$KEEP" ] || { : > "$OUT/windows.verdicts"; ssh -o BatchMode=yes "$WINDOWS" "del $WORK\\$N-cycles.txt $WORK\\$N-verdicts.txt 2>nul" > /dev/null 2>&1; }
    st=$(legsteps windows); case " $st " in *" wbuild "*) windows_step wbuild || return 0; st=$(echo " $st " | sed 's/ wbuild / /');; esac
    [ "$(boxof cycles)" = windows ] && [ -z "$(why cycles)" ] && ! done_ cycles && st="$st cycles"   # wrun joins it
    pool "${WINLANES:-10}" wrun wwid wmore $st; }
# a Windows step at <w> lanes, its start and end timed (the overlap is read from these lines)
wrun() { [ $1 = cycles ] && { cycles_join windows || return; }; echo "wave-gate: windows $1 starts, $2 lanes $(date +%H:%M:%S)"; windows_step "$1" "$2"
    echo "wave-gate: windows $1 ends $(date +%H:%M:%S)"; }
# a wide step takes WINLANES/2 (all that is free when it is the last); a narrow one 2; cdb and wfixed wait for a winpass
wwid() { case $1 in cdb|wfixed*) case " $pq $pr" in *" winpass"*|*:winpass*)
        awk -F'\t' '$1 ~ /^winpass/ { f = 1 } END { exit !f }' "$OUT/windows.verdicts" 2>/dev/null || return 0;; esac;; esac
    case $1 in names|overload|winstruct|cdb|cycles|declines|release) echo 2;; *) h=$(( ${WINLANES:-10} / 2 )); [ "$3" -le 1 ] && [ "$2" -gt "$h" ] && h=$2; echo $h;; esac; }
wmore() { claim windows; }

# one Mac job at a time, niced, at -j2, under its cap (the user, 2026-11-13); nothing here runs unless mac is a box
mac_leg() {
    [ -n "$KEEP" ] || : > "$OUT/mac.verdicts"; st=$(legsteps mac); [ -n "$st" ] || return 0
    mjob() { c=$1; shift; (cd "$MACDIR" && MAKEFLAGS=-j2 JOBS=2 nice -n 10 lockf -t 3600 "$HOME/.maclock" perl -e 'alarm shift; exec @ARGV' "$c" "$@"); }
    for s in $st; do
        L="$OUT/$s.log"
        case $s in
        mbuild) rm -rf "$MACDIR" && mkdir -p "$MACDIR" && tar -C "$MACDIR" -xzf "$OUT/tree.tgz" && mjob 540 make -j2 cxx3.exe > "$L" 2>&1 &&
                verdict mbuild PASS "cxx3.exe built by clang++" mac || { verdict mbuild FAIL "$(grep -m1 error "$L" | cut -c1-160); $L" mac; return; } ;;
        mrun[02]) f=-O${s#mrun}; mjob 1500 env CXX1="./cxx3.exe $f" sh tests/run.sh > "$L" 2>&1; rc=$?; d=$(grep -a '^run.sh: ' "$L" | tail -1 | cut -c1-200)
            [ $rc -eq 0 ] && [ -n "$d" ] && verdict "$s" PASS "$f $d" mac || verdict "$s" FAIL "$f rc $rc; ${d:-no count}; $L" mac ;;
        mfixed) d=; ok=1; n=$(find "$MACDIR/src" -name "*.cpp" | wc -l | tr -d " ")
            for f in "" -O2; do o=$MACDIR-mfixed${f:--O0}
                for stg in 0 1 2 3; do res=
                    for try in 1 2 3; do mjob 1500 env SELFHOST_JOBS=2 SELFHOST_RESUME=$res sh tools/self-host "$o" "$f" $stg >> "$L" 2>&1; [ $? -eq 142 ] || break; res=1; done
                done
                a=$(grep -a 'the same object from stages 0, 1 and 2' "$L" | tail -1); c=$(grep -a 'the same object from stages 2 and 3' "$L" | tail -1)
                case "$a|$c" in "self-host: $n of $n "*"|self-host: $n of $n "*) d="$d ${f:--O0}: $n of $n from stages 0, 1, 2 and from 2, 3;" ;;
                    *) ok=0; d="$d ${f:--O0}: ${a:-stages 0-2 not compared}; ${c:-stages 2-3 not compared};" ;; esac
            done
            [ $ok = 1 ] && verdict mfixed PASS "arm64-darwin$d" mac || verdict mfixed FAIL "arm64-darwin$d $L" mac ;;
        lldb) mjob 600 sh tests/debug.sh lldb ./cxx3.exe > "$L" 2>&1; rc=$?; d=$(grep -a '^debug.sh lldb' "$L" | tail -1)
            [ $rc -eq 0 ] && [ -n "$d" ] && verdict lldb PASS "$d" mac || verdict lldb FAIL "rc $rc; ${d:-no count}; $L" mac ;;
        *) verdict "$s" FAIL "the Mac runs no step $s (the user's split: the C6000 and the comparisons are the boxes')" mac ;;
        esac
    done
}

if [ -n "$PLAN" ]; then for b in linux windows mac; do has $b && echo "wave-gate: $b runs: $(legsteps $b)"; done
    has linux && echo "wave-gate: linux: the build alone, then ${WAVEGATE_SLOTS:-2} steps at once through ~/slot (two locks, each job -j2 JOBS=2 SELFHOST_JOBS=2, timeout 1500)"
    has windows && echo "wave-gate: windows: wbuild alone, then steps at once within WINLANES=${WINLANES:-10} at /affinity 3FF - wide $(( ${WINLANES:-10} / 2 )) lanes (the last one all that is free), names/overload/winstruct/cdb/cycles/declines/release 2; cdb and wfixed after a winpass"
    echo "wave-gate: never together, one tree folder each: run1+run2+maketest, ssa1+ssa2, tms*/wtms*/sim, asm*, winpass*+cdb+wfixed* (winout-tools)"
    echo "wave-gate: alone on its box (relinks cxx3-msvc.exe): wselfc, wfixed0, wfixed2; linux selfc, fixed*, maketest FAIL unless make -q cxx3.exe holds"
    echo "wave-gate: idle steps, to the first box free: $(group idle)"; exit 0; fi
if [ -z "$REPORT" ]; then
    WT=$OUT/tree; T0=$(date +%s)
    if [ -n "$KEEP" ] && [ -s "$OUT/commit" ]; then      # -k: the trees on the boxes are the first run's
        [ "$(git -C "$ROOT" rev-parse "$COMMIT")" = "$(cat "$OUT/commit")" ] || echo "wave-gate: -k keeps the trees of $(cat "$OUT/commit"); $COMMIT is not what runs"
    else
        [ "$COMMIT" != HEAD ] || [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ] || echo "wave-gate: the working tree has uncommitted edits - the gate is of HEAD, not of them"
        git -C "$ROOT" rev-parse "$COMMIT" > "$OUT/commit" && git -C "$ROOT" archive --format=tar.gz -o "$OUT/tree.tgz" "$COMMIT" || exit 2
        rm -f "$OUT/base.tgz"; echo "$BASE" > "$OUT/base"
        [ -z "$BASE" ] || git -C "$ROOT" archive --format=tar.gz -o "$OUT/base.tgz" "$BASE" || exit 2
        # the Windows box takes a checkout (winbuild.sh ships git's files): the commit's, with this script in it
        git -C "$ROOT" worktree remove --force "$WT" 2>/dev/null; rm -rf "$WT"
        git -C "$ROOT" worktree add -q --detach "$WT" "$(cat "$OUT/commit")" || exit 2
        cp "$ROOT/tools/wave-gate" "$WT/tools/wave-gate"; rm -rf "$OUT/claim" "$OUT/chose"; mkdir -p "$OUT/claim"
    fi
    echo "wave-gate: $N at $(cat "$OUT/commit"), the wave's base ${BASE:-not named (-w)}, boxes: $BOXES, $(date '+%Y-%m-%d %H:%M')"
    echo "wave-gate: the fixed point ${FIXED_OWED:+is owed: $FIXED_OWED}$([ -n "$FIXED_OWED" ] || echo "is not owed: its steps NOT RUN, checked")"
    for b in linux windows mac; do has $b && echo "wave-gate: $b runs: $(legsteps $b)"; done
    echo "wave-gate: idle steps, to the first box free: $(group idle)"
    has linux && linux_leg &
    has windows && windows_leg &
    has mac && mac_leg
    wait
    echo "wave-gate: wall time $(( ($(date +%s) - T0) / 60 )) minutes" | tee "$OUT/wall"
fi

# ---- the report: every step of the table, in its order, with the box that ran it
pass=0; fail=0; notrun=0; unexcused=0
vof() { awk -F'\t' -v s="$1" '$1 == s { print $2 "\t" $3 }' "$OUT/$2.verdicts" 2>/dev/null | tail -1; }
echo "wave-gate: $N at $(cat "$OUT/commit" 2>/dev/null || echo '?'), the wave's base $(cat "$OUT/base" 2>/dev/null)"
for s in $STEPS; do
    x=$(boxof $s); r=$(why "$s"); b=$x; v=
    case $x in
    split) if has linux && has windows; then
            a=$(vof "$s@$SPLIT_LINUX" linux); c=$(vof "$s@$SPLIT_WINDOWS" windows); b=lin+win
            if [ -n "$a" ] && [ -n "$c" ]; then
                n=$(printf '%s\n%s\n' "$a" "$c" | sed -n 's/.*: \([0-9]*\) passed, \([0-9]*\) failed.*/\1 \2/p' | awk '{ p += $1; f += $2 } END { print p, f }')
                case "$a$c" in *FAIL*|*NOT\ RUN*) k=FAIL;; *) k=PASS;; esac
                v="$k${TAB}joined ${n% *} passed, ${n#* } failed | linux ${a#*$TAB} | windows ${c#*$TAB}"
            elif [ -n "$a$c" ]; then v="FAIL${TAB}one half only: linux ${a:-none} | windows ${c:-none}"; fi
        else for b in linux windows; do has $b && { v=$(vof "$s@1-$NSHARD" $b); break; }; done; fi ;;
    report) b=mac; c=$(cat "$OUT/commit" 2>/dev/null); ch=$(git -C "$ROOT" diff --name-only "$c" HEAD -- $BASELINES 2>&1 | tr '\n' ' ')
        if [ -z "$ch" ]; then v="PASS${TAB}at HEAD $(git -C "$ROOT" rev-parse --short=8 HEAD) the judges' files are the gated commit's"
        else v="FAIL${TAB}changed after the gated commit: $ch- gate the commit that holds them"; fi ;;
    idle) b=$(awk -v s="$s" '$1 == s { print $2 }' "$OUT/chose" 2>/dev/null | tail -1); [ -n "$b" ] && v=$(vof "$s" "$b")
        [ -n "$v" ] && v="${v%%$TAB*}${TAB}(idle: $b) ${v#*$TAB}"
        [ -z "$v" ] && [ -n "$b" ] && v="FAIL${TAB}(idle: $b) claimed, and no verdict came back"; b=${b:-idle} ;;
    *) v=$(vof "$s" "$x") ;;
    esac
    case "$v" in
    PASS*) pass=$((pass + 1)); printf '  %-8s %-9s PASS     %s\n' "$b" "$s" "${v#*$TAB}" ;;
    FAIL*) fail=$((fail + 1)); printf '  %-8s %-9s FAIL     %s\n' "$b" "$s" "${v#*$TAB}" ;;
    *)  notrun=$((notrun + 1)); d=${v#*$TAB}
        if [ -n "$r" ]; then d=$r
        elif [ -z "$v" ]; then unexcused=$((unexcused + 1))
            case $x in split|idle) d="no verdict came back (no reason given)";;
            *) if has $x; then d="no verdict came back - the step before it stopped the chain, or the box did not answer (no reason given)"
               else d="box $x was not asked (no reason given)"; fi;; esac
        else unexcused=$((unexcused + 1)); d="$d (the box's reason, none on the command line)"; fi
        printf '  %-8s %-9s NOT RUN  %s\n' "$b" "$s" "$d" ;;
    esac
done
[ -f "$OUT/wall" ] && cat "$OUT/wall"
echo "wave-gate: $pass passed, $fail failed, $notrun not run ($unexcused with no reason on the command line)"
[ $fail -eq 0 ] && [ $unexcused -eq 0 ]
