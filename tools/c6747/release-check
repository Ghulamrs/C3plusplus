#!/bin/sh
# release-check - one check, run once per release, that the C6000 emulator cannot
# fool. Two wrong-output defects reached a release because every suite runs the
# C6000 on VM6747 and the emulator agreed with the compiler both times: C2, DPSP's
# three delay slots (a float {1.0} printed 0 on TI's silicon), and C1, a thrown
# pointer caught one dereference short on TI's runtime. VM6747 reads the assembly
# text and models the runtime, so it hides both a scheduling fault and a runtime
# difference. Only TI's own C6747 cycle-accurate simulator told the truth.
#
#   tools/c6747/release-check            the sample in tools/c6747/release-check-sample.txt,
#                                        and the lambda cases the C6000 does not refuse
#
# It answers two questions and exits non-zero on any disagreement:
#   1. Does ASM6x encode what TI's assembler encodes? (advisory) Each sample is
#      assembled by cl6x 8.2.2 and by ASM6x at -O1, -O2 and -Os; dis6x
#      disassembles both and the decoded instructions are compared.
#   2. Does the program do on TI's simulator what its .expected says? Each sample
#      runs at -O2 on the CCS 5.5 C6747 cycle-accurate simulator, VM6747's answer
#      beside it: a simulator failure the emulator passes is the class that
#      reached a release.
#
# **All of it runs on the Windows box** - the C6000 does not run on the Mac. This
# ships the tree there, builds cxx3 with cl, and runs tools/c6747/release-check-box.py,
# which compiles with that cxx3, assembles and emulates with the ASM6x and VM6747 built
# from source in C:\Users\GRA\work\ti6x, and runs TI's half (release-check.cmd).
#
# To reproduce the C1/C2 bite, point it at the pre-fix tools on the box:
#   ASM6X_WIN=... VM6747_WIN=... tools/c6747/release-check   (and a tree at 2a09fe6)
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
WINDOWS=${WINDOWS_BOX:-windows}
WTREE='C:\Users\GRA\work\release-check-tree'
ASM6X_WIN=${ASM6X_WIN:-'C:\Users\GRA\work\ti6x\ASM6x\build\ASM6x.exe'}
VM6747_WIN=${VM6747_WIN:-'C:\Users\GRA\work\ti6x\VM6747\vm6747.exe'}
T0=$(date +%s)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

echo "release-check: shipping the tree to $WINDOWS"
( cd "$ROOT" && COPYFILE_DISABLE=1 tar --no-xattrs -czf "$WORK/tree.tgz" --exclude 'obj*' --exclude 'tests/out-*' \
    --exclude .git --exclude '* [0-9]' --exclude '* [0-9].*' --exclude cxx3.exe src include lib msvc tests tools ) || exit 1
scp -q -o BatchMode=yes "$WORK/tree.tgz" "$WINDOWS:C:/Users/GRA/work/release-check-tree.tgz" &&
ssh -o BatchMode=yes "$WINDOWS" "rmdir /s /q $WTREE 2>nul & mkdir $WTREE && tar -C $WTREE -xzf C:\\Users\\GRA\\work\\release-check-tree.tgz && del C:\\Users\\GRA\\work\\release-check-tree.tgz" > /dev/null ||
    { echo "release-check: cannot ship to $WINDOWS"; exit 1; }
echo "release-check: building cxx3 there with cl"
ssh -o BatchMode=yes "$WINDOWS" "$WTREE\\msvc\\build.cmd" > "$WORK/build.log" 2>&1 ||
    { echo "release-check: cxx3 did not build on $WINDOWS"; tr -d '\r' < "$WORK/build.log" | tail -8; exit 1; }
ssh -o BatchMode=yes -o ServerAliveInterval=30 "$WINDOWS" \
    "python $WTREE\\tools\\c6747\\release-check-box.py $WTREE $WTREE\\cxx3-msvc.exe $ASM6X_WIN $VM6747_WIN" > "$WORK/box.log" 2>&1
rc=$?
tr -d '\r' < "$WORK/box.log"
echo "release-check: $(( $(date +%s) - T0 ))s from here"
exit $rc
