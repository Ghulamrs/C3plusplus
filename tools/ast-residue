#!/usr/bin/env python3
"""What is left of `Ast.h`, counted: R7 of the M3 review and section 12.2 of the design.

    tools/ast-residue             every site, file:line and what it is
    tools/ast-residue --count     the counts, one per kind
    tools/ast-residue --check     fail if any count is above tools/ast-residue.baseline, or the baseline is above
                                  tools/ast-residue.start on a line without the user's mark; print the delta from the start
    tools/ast-residue --record    write today's counts as the baseline; refused for any count above the baseline
    tools/ast-residue --readers   every file under src/ that includes Ast.h, with its count of node-kind names

M3b.7 deleted x86's walk of `Ast.h` and kept the rest (design 12.2): the parser's building half, `Classes`'
synthesised bodies and the constant evaluator's reads (the tms6747 walker went at M6d, arm64's at M5.3). Each
moves with a later row; until then the residue may only go down, as the memory gate's counts do. The kinds:

    ExprPtr, StmtPtr   the words, under src/parser and src/sema
    node-casts         a cast to an Ast.h node kind (`dynamic_cast<const Unary *>`), under src/parser and src/sema
    node-refs          a node kind held by another spelling - `Unary *u`, `const Expr &e`, `unique_ptr<Call>`, an
                       alias of ExprPtr or StmtPtr - under src/parser and src/sema (N13 of the mend review)
    readers            files under src/ that include Ast.h
    visits             a generator's visit of a node kind, declared or defined (`visit(const Unary &`), under src/backend
    ast-lines          the lines of src/Ast.h itself

The start file holds the milestone's start, written by the coordinator when a milestone opens and never edited inside
one. A baseline line above it must carry the user's mark, `user-approved YYYY-MM-DD` after the count (for example
`ExprPtr 2017 user-approved 2026-11-20 Q12`); only the coordinator writes the mark, and only on the user's word in
chat (Q7 of the M6c review, 2026-11-15). --record never raises a count, so a raise is always a hand-written line.

The node kinds are read from src/Ast.h (every class deriving from Node, Expr or Stmt), never listed here.
Comments, string and character literals are skipped.
"""
import os
import re
import signal
import sys

if hasattr(signal, "SIGPIPE"): signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # `| head` ends the listing quietly

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
SRC = os.path.join(ROOT, "src")
AST = os.path.join(SRC, "Ast.h")
BASELINE = os.path.join(ROOT, "tools", "ast-residue.baseline")
START = os.path.join(ROOT, "tools", "ast-residue.start")
MARK = re.compile(r"\buser-approved \d{4}-\d{2}-\d{2}\b")
SCOPED = ("src/parser", "src/sema")
KINDS = ("ExprPtr", "StmtPtr", "node-casts", "node-refs", "visits", "readers", "ast-lines")
INCLUDE = re.compile(r'^\s*#\s*include\s*"(?:\.\./)*Ast\.h"', re.M)


def code_only(text):
    """The text with comments and literals blanked, line breaks kept (the memory gate's reader)."""
    out = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if text.startswith("//", i):
            j = text.find("\n", i)
            j = n if j < 0 else j
            out.append(" " * (j - i))
            i = j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            j = n if j < 0 else j + 2
            out.append(re.sub(r"[^\n]", " ", text[i:j]))
            i = j
        elif c in "\"'":
            j = i + 1
            while j < n and text[j] != c:
                j += 2 if text[j] == "\\" else 1
            out.append(" " * (min(j + 1, n) - i))
            i = j + 1
        else:
            out.append(c)
            i += 1
    return "".join(out)


def node_kinds():
    with open(AST, encoding="utf-8", errors="replace") as f:
        code = code_only(f.read())
    kinds = set(["Node", "Expr", "Stmt"])
    while True:
        more = set(m.group(1) for m in re.finditer(r"\b(?:class|struct)\s+(\w+)\s*(?:final\s*)?:\s*(?:public\s+)?(\w+)", code)
                   if m.group(2) in kinds)
        if more <= kinds:
            return kinds
        kinds |= more


def sources():
    for top, dirs, names in os.walk(SRC):
        dirs.sort()
        for name in sorted(names):
            if name.endswith((".cpp", ".h")):
                path = os.path.join(top, name)
                with open(path, encoding="utf-8", errors="replace") as f:
                    text = f.read()
                yield os.path.relpath(path, ROOT), text


def sites():
    kinds = node_kinds()
    cast = re.compile(r"\b(?:dynamic|static|reinterpret|const)_cast\s*<\s*(?:const\s+)?(\w+)\s*(?:const\s*)?[*&]")
    ref = re.compile(r"\b(\w+)\s*(?:const\s*)?[*&]+\s*(?:const\s+)?[A-Za-z_]\w*\s*[,;=()\[{:]")
    held = re.compile(r"\b(?:unique_ptr|shared_ptr|Owned)\s*<\s*(?:const\s+)?(\w+)\s*>")
    alias = re.compile(r"\b(?:typedef\s+(?:ExprPtr|StmtPtr)\s+\w+|using\s+\w+\s*=\s*(?:ExprPtr|StmtPtr))\b")
    visit = re.compile(r"\bvisit\s*\(\s*const\s+(\w+)\s*&")
    found, readers = [], []
    for rel, text in sources():
        if INCLUDE.search(text):
            readers.append(rel)
        if rel.replace(os.sep, "/").startswith("src/backend/"):
            for lineno, line in enumerate(code_only(text).split("\n"), 1):
                for m in visit.finditer(line):
                    if m.group(1) in kinds:
                        found.append((rel, lineno, "visits " + m.group(1)))
        if not rel.startswith(SCOPED):
            continue
        for lineno, line in enumerate(code_only(text).split("\n"), 1):
            for m in re.finditer(r"\b(ExprPtr|StmtPtr)\b", line):
                found.append((rel, lineno, m.group(1)))
            for m in cast.finditer(line):
                if m.group(1) in kinds:
                    found.append((rel, lineno, "node-casts " + m.group(1)))
            bare = cast.sub(" ", line)
            for m in list(ref.finditer(bare)) + list(held.finditer(bare)):
                if m.group(1) in kinds:
                    found.append((rel, lineno, "node-refs " + m.group(1)))
            for m in alias.finditer(line):
                found.append((rel, lineno, "node-refs alias"))
    return found, readers


def counts(path):
    """kind -> (count, the rest of its line); `#` lines are the file's record and are skipped."""
    out = {}
    with open(path) as f:
        for line in f:
            parts = line.split(None, 2)
            if len(parts) >= 2 and not parts[0].startswith("#"):
                out[parts[0]] = (int(parts[1]), parts[2].strip() if len(parts) > 2 else "")
    return out


def unmarked_raises(was, start):
    """The baseline's kinds above the milestone's start on a line without the user's mark."""
    return [k for k in KINDS if k in was and k in start and was[k][0] > start[k][0] and not MARK.search(was[k][1])]


def main(argv):
    found, readers = sites()
    now = dict((k, 0) for k in KINDS)
    for _, _, what in found:
        now[what.split()[0]] += 1
    now["readers"] = len(readers)
    with open(AST, encoding="utf-8", errors="replace") as f:
        now["ast-lines"] = sum(1 for _ in f)
    if len(argv) == 1:
        for path, lineno, what in found:
            print("%s:%d: %s" % (path, lineno, what))
        return 0
    if argv[1] == "--readers":
        kinds = node_kinds()
        for rel in readers:
            with open(os.path.join(ROOT, rel), encoding="utf-8", errors="replace") as f:
                words = re.findall(r"\b\w+\b", code_only(f.read()))
            print("%s: %d node-kind names" % (rel, sum(1 for w in words if w in kinds)))
        return 0
    if argv[1] == "--count":
        print(" ".join("%s %d" % (k, now[k]) for k in KINDS))
        return 0
    if argv[1] == "--record":
        was = counts(BASELINE)
        up = [k for k in KINDS if k in was and now[k] > was[k][0]]
        for k in up:
            print("ast-residue: --record refused: %s %d is above the baseline's %d - a raise is the user's word, written"
                  " by the coordinator as a marked line (see the header)" % (k, now[k], was[k][0]))
        if up:
            return 1
        start = counts(START)
        with open(BASELINE, "w") as f:
            for k in KINDS:
                keep = k in was and k in start and now[k] > start[k][0] and MARK.search(was[k][1])
                f.write("%s %d%s\n" % (k, now[k], " " + was[k][1] if keep else ""))
        print("ast-residue: baseline recorded: " + " ".join("%s %d" % (k, now[k]) for k in KINDS))
        return 0
    if argv[1] == "--check":
        was, start = counts(BASELINE), counts(START)
        for k in KINDS:
            if k not in was:
                print("ast-residue: %s is not in tools/ast-residue.baseline - a kind with no baseline fails" % k)
        risen = [k for k in KINDS if now[k] > was.get(k, (-1, ""))[0]]
        for k in (k for k in risen if k in was):
            print("ast-residue: %s rose from %d to %d - design 12.2 lets the residue only go down" % (k, was[k][0], now[k]))
        raised = unmarked_raises(was, start)
        for k in raised:
            print("ast-residue: the baseline's %s %d is above the start's %d with no user-approved mark - refused"
                  % (k, was[k][0], start[k][0]))
        print("ast-residue: against the start (tools/ast-residue.start): " +
              " ".join("%s %d (%+d)" % (k, now[k], now[k] - start[k][0]) if k in start else "%s %d (no start)" % (k, now[k])
                       for k in KINDS))
        fallen = [k for k in KINDS if k in was and now[k] < was[k][0]]
        if fallen and not risen:
            print("ast-residue: lower than the baseline (" + ", ".join(fallen) + "); run --record to keep it")
        return 1 if risen or raised else 0
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
