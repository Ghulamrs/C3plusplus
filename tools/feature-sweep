def run(cmd, src):
    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, "probe.cpp")
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(src + "\n")
        p = subprocess.run(cmd + [path], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, cwd=d)
        return p.returncode, p.stdout


def main():
    args = sys.argv[1:]
    if "--list" in args:
        for pid, expect, _ in PROBES:
            print(f"{pid:32} {expect}")
        return 0
    clang = None
    if "--clang" in args:
        clang = args[args.index("--clang") + 1]
    cxx1 = os.environ.get("CXX1", os.path.join(ROOT, "cxx3.exe"))
    clangflags = os.environ.get("CLANGFLAGS", "").split()

    bins = {"compiles": [], "refused by name": [], "refused naming nothing": []}
    oracle_faults = []
    for pid, expect, src in PROBES:
        if clang:
            rc, _ = run([clang, "-x", "c++", "-std=c++11", "-pedantic-errors", "-fsyntax-only"] + clangflags, src)
            if (rc == 0) != (expect == "accept"):
                oracle_faults.append(f"{pid}: clang {'accepts' if rc == 0 else 'refuses'} a probe the row says it should {'refuse' if expect == 'refuse' else 'accept'}")
        rc, out = run([cxx1, "-nologo", "-S", "-arch", "x86_64-linux", "-o", "probe.s"], src)
        if rc == 0:
            bins["compiles"].append(pid)
            verdict = "compiles" + ("" if expect == "accept" else "  <- the standard refuses this")
        elif NAMED.search(out):
            bins["refused by name"].append(pid)
            verdict = "refused by name"
        else:
            bins["refused naming nothing"].append(pid)
            verdict = "REFUSED NAMING NOTHING: " + " ".join(out.split())[:160]
        print(f"{pid:32} {verdict}")

    print()
    for k in bins:
        print(f"{k:24} {len(bins[k])}")
    print(f"{'probes':24} {len(PROBES)}")
    if oracle_faults:
        print("\nthe sweep's own faults (the row and the oracle disagree):")
        for f in oracle_faults:
            print("  " + f)
    return 1 if (bins["refused naming nothing"] or oracle_faults) else 0


if __name__ == "__main__":
    sys.exit(main())
