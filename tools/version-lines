#!/usr/bin/env python3
"""The version lines of the two READMEs, generated from src/Version.h.

    tools/version-lines            rewrite every line that names the release
    tools/version-lines --check    say which lines disagree with Version.h; exit 1 if any

**A version written in two places is a version that disagrees with itself the
first time one of them is edited.** README.1ST said 1.4 and 18-09-2026 for three
releases after Version.h said otherwise, README.md kept a heading "Known
shortcomings in 1.4", and the review of 2026-10-08 read them beside a binary
that said 1.6. Version.h is the one source - the compiler prints it, the seal
is named from it - so these lines are derived from it rather than kept.

What is rewritten, each by a pattern rather than a line number, so that the
documents may be edited freely around them:

  README.1ST   the banner line, wherever it is quoted (`©2026 G. R. Akhtar - ...`)
               `This is **version N**, sealed **DD-MM-YYYY**.`
               `cxx1-N.dat` in the seal paragraph
               `shortcomings in N"`, the cross-reference to README.md
  README.md    `## Known shortcomings in N`
               `a user of **N**`

`tools/seal write` runs this first, so a seal is never written beside a stale
README; `tools/seal check` runs the check, so a stale one fails the gate.
"""
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.normpath(os.path.join(HERE, ".."))


def fromVersionHeader(macro):
    """The name, not a prefix of it - CXX1_VERSION_H is the include guard."""
    for line in open(os.path.join(ROOT, "src", "Version.h"), encoding="utf-8"):
        parts = line.split()
        if len(parts) >= 3 and parts[0] == "#define" and parts[1] == macro:
            return line.split('"')[1]
    sys.exit("version-lines: src/Version.h has no %s" % macro)


VERSION = fromVersionHeader("CXX1_VERSION")
SEAL_DATE = fromVersionHeader("CXX1_SEAL_DATE")
SEAL_FILE = fromVersionHeader("CXX1_SEAL_FILE")
BANNER = fromVersionHeader("CXX1_BANNER")

# (file, pattern, replacement) - the pattern's groups keep whatever surrounds the
# version so the sentence around it is the author's and only the number is the tool's.
RULES = [
    ("README.1ST", re.compile(r"^(\s*)©2026 G\. R\. Akhtar - .*$"),
     lambda m: m.group(1) + BANNER),
    ("README.1ST", re.compile(r"^This is \*\*version [0-9.]+\*\*, sealed \*\*[0-9-]+\*\*\.$"),
     lambda m: "This is **version %s**, sealed **%s**." % (VERSION, SEAL_DATE)),
    ("README.1ST", re.compile(r"^(\s*)cxx1-[0-9.]+\.dat(\s+.*)$"),
     lambda m: m.group(1) + SEAL_FILE + m.group(2)),
    ("README.1ST", re.compile(r'^shortcomings in [0-9.]+"(.*)$'),
     lambda m: 'shortcomings in %s"%s' % (VERSION, m.group(1))),
    ("README.md", re.compile(r"^## Known shortcomings in [0-9.]+$"),
     lambda m: "## Known shortcomings in %s" % VERSION),
    ("README.md", re.compile(r"^(.*)a user of \*\*[0-9.]+\*\*(.*)$"),
     lambda m: "%sa user of **%s**%s" % (m.group(1), VERSION, m.group(2))),
]


def run(check):
    stale = 0
    for name in sorted(set(f for f, _, _ in RULES)):
        path = os.path.join(ROOT, name)
        lines = open(path, encoding="utf-8").read().split("\n")
        hits = {}
        for i, line in enumerate(lines):
            for f, pat, repl in RULES:
                if f != name:
                    continue
                m = pat.match(line)
                if m and pat.sub(repl, line) != line:
                    hits[i] = pat.sub(repl, line)
        for i in sorted(hits):
            stale += 1
            print("%s:%d: %s" % (name, i + 1, lines[i].strip()))
            print("%s   -> %s" % (" " * len(name), hits[i].strip()))
            lines[i] = hits[i]
        if hits and not check:
            open(path, "w", encoding="utf-8").write("\n".join(lines))
    if check:
        print("version-lines: %d line(s) disagree with src/Version.h (%s, %s)"
              % (stale, VERSION, SEAL_DATE) if stale else
              "version-lines: README.md and README.1ST agree with src/Version.h (%s, %s)"
              % (VERSION, SEAL_DATE))
        return 1 if stale else 0
    print("version-lines: %d line(s) rewritten to %s, %s" % (stale, VERSION, SEAL_DATE))
    return 0


if __name__ == "__main__":
    args = sys.argv[1:]
    if args and args[0] not in ("--check",):
        print(__doc__)
        sys.exit(2)
    sys.exit(run(check=bool(args)))
