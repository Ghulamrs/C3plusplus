#!/bin/sh
# Run C programs on the three TMS320C6747 boxes at once, from the Mac, and compare.
#
#   tools/c6747-three                    every program in tools/c6747/programs
#   tools/c6747-three prog.c ...         these programs, .c or .cpp
#   tools/c6747-three tools/c6747/bench  every program in a directory - the kernels
#                                        timed against cl6x -O2
#
# The three boxes, two machines:
#   windows-ccs74-vm   the Windows box, CCS 7.4's cl6x 8.2.2 to assembly, run on VM6747.
#                      CCS 7.4 ships no simulator; the emulator is this box's target.
#   windows-ccs55      the Windows box, CCS 5.5's cl6x 7.4.4, the C6747 cycle-accurate simulator
#   linux-ccs55        the Linux box, the same CCS 5.5 compiler and simulator, 32-bit
#                      under the i686 runtime in /opt/i386
# A program passes when every box prints what <prog>.expected says, VM6747 exits with
# <prog>.rc (0 when there is none), and each simulator stopped at C$$EXIT. The
# simulators report no status: TI's startup calls exit(1) whatever main returns. With no
# .expected the three boxes are compared with each other instead. The two
# simulators run the same compiler on the same model, so their cycle counts must
# agree too, and a difference is a failure.
#
# And cpp11 as a fourth and fifth column: cpp11 -O2 and asm6x here, to a TI object,
# linked on both simulator boxes exactly as cl6x's -O2 build is - the same linker,
# C6747.cmd, heap, stack and rts6740_elf_eh.lib - so TI's simulator times both.
# The ratio printed is cpp11's cycles over cl6x's: the gap -O2 has to close.
#
# C6747_AFTER=<pid> holds the Linux box back until that process has gone: the box
# has 419 MB, and verify-three's Linux build must not share it with a DSS run.
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
KEY=${CXX1_LINUX_KEY:-$HOME/Documents/Claude/myMorningWalk.pem}
LINUX=${CXX1_LINUX:-ec2-user@52.202.164.123}
WINDOWS=${WINDOWS_BOX:-windows}
WREMOTE='C:\Users\GRA\work\c6747-run'
LREMOTE='c6747-run'
BOXES="windows-ccs74-vm windows-ccs55 linux-ccs55 windows-ccs55-cpp11 linux-ccs55-cpp11"
T0=$(date +%s)

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/c6747/programs"
cp "$ROOT"/tools/c6747/*.* "$WORK/c6747/"
if [ $# -eq 0 ]; then set -- "$ROOT"/tools/c6747/programs; fi
FILES=""
for a in "$@"; do
    if [ -d "$a" ]; then set -- "$a"/*.c "$a"/*.cpp; else set -- "$a"; fi
    for p in "$@"; do
        [ -f "$p" ] || continue
        case "$(basename "$p")" in *" "[0-9]*) continue;; esac   # iCloud's copies
        d=$(dirname "$p"); f=$(basename "$p"); n=${f%.*}
        cp "$p" "$WORK/c6747/programs/"
        for x in expected rc; do [ -f "$d/$n.$x" ] && cp "$d/$n.$x" "$WORK/c6747/programs/"; done
        FILES="$FILES $f"
    done
done
NAMES=$(for f in $FILES; do echo "${f%.*}"; done)

# cpp11's own build, here on the Mac: cpp11 -O2 to assembly, asm6x to a TI object,
# shipped as programs/<prog>.cpp11.obj for both simulator boxes to link and run.
# cpp11 compiles C++, so each program goes in under a .cpp name.
CPP11=${CPP11:-$ROOT/cpp11.exe}
ASM6X=${ASM6X:-$ROOT/../../TI/ASM6x/build/asm6x.exe}
# COMPRESS=1 (default): cpp11's objects --compress, cl6x its own default, compressed; COMPRESS=0:
# both plain, ASM6x and cl6x --no_compress - the two sides always built alike
COMPRESS=${COMPRESS:-1}
if [ "$COMPRESS" = 1 ]; then ASM6X_FLAGS=--compress; TI_COMPRESS=; else ASM6X_FLAGS=--no_compress; TI_COMPRESS=--no_compress; fi
CPP11_FLAGS=${CPP11_FLAGS:--O2}
mkdir -p "$WORK/cpp11"
for f in $FILES; do
    n=${f%.*}
    cp "$WORK/c6747/programs/$f" "$WORK/cpp11/$n.cpp"
    if "$CPP11" -arch tms6747 -nologo $CPP11_FLAGS -S "$WORK/cpp11/$n.cpp" -o "$WORK/cpp11/$n.s" \
           > "$WORK/cpp11/$n.log" 2>&1 &&
       "$ASM6X" $ASM6X_FLAGS "$WORK/cpp11/$n.s" -o "$WORK/c6747/programs/$n.cpp11.obj" >> "$WORK/cpp11/$n.log" 2>&1; then :
    else
        echo "c6747-three: cpp11 did not build $n:"; sed 's/^/      /' "$WORK/cpp11/$n.log" | head -4
    fi
    # For the size table: cpp11 -O1, the level that optimises for size. Not shipped.
    "$CPP11" -arch tms6747 -nologo -O1 -S "$WORK/cpp11/$n.cpp" -o "$WORK/cpp11/$n.O1.s" > /dev/null 2>&1 &&
        "$ASM6X" $ASM6X_FLAGS "$WORK/cpp11/$n.O1.s" -o "$WORK/cpp11/$n.O1.obj" > /dev/null 2>&1
done
COPYFILE_DISABLE=1 tar -C "$WORK" --no-xattrs -czf "$WORK/c6747.tgz" c6747
WPROGS=$(for f in $FILES; do printf '%s\\programs\\%s ' "$WREMOTE\\c6747" "$f"; done)
LPROGS=$(for f in $FILES; do printf '%s/c6747/programs/%s ' "$LREMOTE" "$f"; done)

# The Windows machine: one unpack, then its two boxes at once.
(
    scp -q -o BatchMode=yes "$WORK/c6747.tgz" "$WINDOWS:C:/Users/GRA/work/c6747.tgz" &&
    ssh -o BatchMode=yes "$WINDOWS" "rmdir /s /q $WREMOTE 2>nul & mkdir $WREMOTE && tar -C $WREMOTE -xzf C:\\Users\\GRA\\work\\c6747.tgz" >/dev/null
) > "$WORK/wship.log" 2>&1 || { echo "c6747-three: cannot ship to $WINDOWS"; cat "$WORK/wship.log"; exit 1; }
ssh -o BatchMode=yes "$WINDOWS" "set TI_COMPRESS=$TI_COMPRESS&& $WREMOTE\\c6747\\vm-ccs74.cmd $WPROGS" > "$WORK/windows-ccs74-vm.log" 2>&1 &
P1=$!
ssh -o BatchMode=yes "$WINDOWS" "set TI_COMPRESS=$TI_COMPRESS&& $WREMOTE\\c6747\\sim-ccs55.cmd $WPROGS" > "$WORK/windows-ccs55.log" 2>&1 &
P2=$!

# The Linux box, after anything it has been told to wait for.
(
    if [ -n "${C6747_AFTER:-}" ]; then
        while kill -0 "$C6747_AFTER" 2>/dev/null; do sleep 5; done
    fi
    scp -q -i "$KEY" -o BatchMode=yes "$WORK/c6747.tgz" "$LINUX:c6747.tgz" &&
    ssh -i "$KEY" -o BatchMode=yes "$LINUX" "rm -rf $LREMOTE && mkdir -p $LREMOTE && tar -C $LREMOTE -xzf c6747.tgz && rm c6747.tgz && TI_COMPRESS=$TI_COMPRESS sh $LREMOTE/c6747/sim-ccs55.sh $LPROGS"
) > "$WORK/linux-ccs55.log" 2>&1 &
P3=$!
wait $P1; wait $P2; wait $P3

# Everything back: each box's stdout and result for each program.
mkdir -p "$WORK/back"
scp -q -o BatchMode=yes "$WINDOWS:C:/Users/GRA/work/c6747-run/c6747/out/*.stdout" "$WINDOWS:C:/Users/GRA/work/c6747-run/c6747/out/*.result" "$WORK/back/" 2>/dev/null
scp -q -i "$KEY" -o BatchMode=yes "$LINUX:$LREMOTE/c6747/out/*.stdout" "$LINUX:$LREMOTE/c6747/out/*.result" "$WORK/back/" 2>/dev/null
# And cl6x's objects, for the size table: -O2 as linked, and -O2 -ms3.
mkdir -p "$WORK/back/o2" "$WORK/back/ms3"
scp -q -i "$KEY" -o BatchMode=yes "$LINUX:$LREMOTE/c6747/out/*.obj" "$WORK/back/o2/" 2>/dev/null
scp -q -i "$KEY" -o BatchMode=yes "$LINUX:$LREMOTE/c6747/out/ms3/*.obj" "$WORK/back/ms3/" 2>/dev/null

field() { tr -d '\r' < "$1" 2>/dev/null | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1; }
pass=0; fail=0
printf '%-10s %-18s %-8s %-4s %-10s %s\n' program box build rc cycles output
for n in $NAMES; do
    want=$WORK/c6747/programs/$n.expected
    wantrc=$(cat "$WORK/c6747/programs/$n.rc" 2>/dev/null || echo 0)
    ok=1; ref=""; cyc_ti=""; cyc_cpp=""
    for b in $BOXES; do
        r=$WORK/back/$n.$b.result; o=$WORK/back/$n.$b.stdout
        build=$(field "$r" build); rc=$(field "$r" rc); count=$(field "$r" count)
        pc=$(field "$r" pc); ex=$(field "$r" exit)
        if [ -f "$o" ]; then tr -d '\r' < "$o" > "$o.lf"; else : > "$o.lf"; fi
        verdict=same
        if [ "$build" != ok ]; then verdict="no build"; ok=0
        elif [ "$rc" != n/a ] && [ "$rc" != "$wantrc" ]; then verdict="exit $rc, wanted $wantrc"; ok=0
        elif [ -n "$pc" ] && [ "$pc" != "$ex" ]; then verdict="stopped at $pc, not C\$\$EXIT"; ok=0
        elif [ -f "$want" ]; then
            cmp -s "$o.lf" "$want" && verdict=expected || { verdict=DIFFERS; ok=0; }
        elif [ -z "$ref" ]; then ref=$o.lf; verdict=reference
        else cmp -s "$o.lf" "$ref" && verdict=agrees || { verdict=DIFFERS; ok=0; }
        fi
        case "$b" in
        *ccs55) [ -z "$cyc_ti" ] && cyc_ti=$count || { [ "$cyc_ti" = "$count" ] || { verdict="$verdict, cycles differ"; ok=0; }; };;
        *ccs55-cpp11) [ -z "$cyc_cpp" ] && cyc_cpp=$count || { [ "$cyc_cpp" = "$count" ] || { verdict="$verdict, cycles differ"; ok=0; }; };;
        esac
        printf '%-10s %-18s %-8s %-4s %-10s %s\n' "$n" "$b" "${build:-none}" "${rc:--}" "${count:--}" "$verdict"
        if [ "$verdict" = DIFFERS ]; then
            if [ -f "$want" ]; then diff "$want" "$o.lf"; else diff "$ref" "$o.lf"; fi | head -6 | sed 's/^/      /'
        fi
    done
    case "$cyc_ti$cyc_cpp" in *[!0-9]*|"") ;; *)
        [ -n "$cyc_ti" ] && [ -n "$cyc_cpp" ] &&
            printf '%-10s cpp11/cl6x cycles %s\n' "$n" "$(echo "scale=2; $cyc_cpp / $cyc_ti" | bc)";;
    esac
    [ $ok -eq 1 ] && pass=$((pass + 1)) || fail=$((fail + 1))
done
# Code bytes: the executable sections of each program's own object, library excluded.
codebytes() {
    [ -f "$1" ] || { echo -; return; }
    python3 - "$1" <<'PY'
import struct, sys
d = open(sys.argv[1], 'rb').read()
shoff, = struct.unpack_from('<I', d, 0x20)
shentsize, shnum = struct.unpack_from('<HH', d, 0x2e)
total = 0
for i in range(shnum):
    h = struct.unpack_from('<IIIIIIIIII', d, shoff + i * shentsize)
    if h[1] == 1 and h[2] & 4: total += h[5]      # SHT_PROGBITS, SHF_EXECINSTR
print(total)
PY
}
echo
printf '%-10s %12s %12s %8s %10s %10s %10s %10s %8s\n' program "cl6x -O2" "cpp11 -O2" ratio \
    "text O2" "text ms3" "cpp11 O2" "cpp11 O1" "O1/ms3"
for n in $NAMES; do
    ti=$(field "$WORK/back/$n.linux-ccs55.result" count)
    cp11=$(field "$WORK/back/$n.linux-ccs55-cpp11.result" count)
    r=-; case "$ti$cp11" in ""|*[!0-9]*) ;; *) r=$(echo "scale=2; $cp11 / $ti" | bc);; esac
    a=$(codebytes "$WORK/back/o2/$n.obj"); b=$(codebytes "$WORK/back/ms3/$n.obj")
    c=$(codebytes "$WORK/c6747/programs/$n.cpp11.obj"); e=$(codebytes "$WORK/cpp11/$n.O1.obj")
    q=-; case "$b$e" in ""|*[!0-9]*) ;; *) q=$(echo "scale=2; $e / $b" | bc);; esac
    printf '%-10s %12s %12s %8s %10s %10s %10s %10s %8s\n' "$n" "${ti:--}" "${cp11:--}" "$r" "$a" "$b" "$c" "$e" "$q"
done
echo

if [ "$fail" -gt 0 ]; then
    for b in windows-ccs74-vm windows-ccs55 linux-ccs55; do echo "--- $b"; tr -d '\r' < "$WORK/$b.log" | grep -v '^BOX ' | tail -5; done
fi
echo "c6747 boxes: $pass passed, $fail failed, in $(( $(date +%s) - T0 ))s"
[ "$fail" -eq 0 ]
