#!/usr/bin/env python3
# The inventory behind docs/EXCLUSIONS.md, taken from the source rather than
# written by hand.
#
# A refusal here is a `src_.fail(...)` whose message says a construct is not
# implemented, or names a standard version. The messages are built from adjacent
# string literals with the offending name spliced in, so the literals are joined
# and a runtime piece becomes a <...> hole.
#
#   tools/exclusions                     the inventory, file:line and message
#   tools/exclusions --count             how many sites and distinct messages
#   tools/exclusions --check FILE        what the source refuses and FILE omits
#   tools/exclusions --lowering          the SSA lowering's outside() and broken() sites
#
# `--check docs/EXCLUSIONS.md` is the point of the tool: it is what stops that
# document becoming the hand-written list it was written to replace. It reads
# the file:line references out of the document and reports every refusal site
# the document does not cite, and every citation that no longer exists.
#
# A hand-written entry is one the inventory cannot derive - a refusal whose
# marker word arrives at run time inside a spliced string, or a `.notarget`
# that refuses a case for one target. Such an entry cites a test file instead
# of a source line - `tests/cases/<name>.cpp`, `.error`, `.notarget` or
# `tests/open/<name>.cpp` - and `--check` verifies the file exists, counting a
# missing one as a stale citation. That is as far as a tool can hold a sentence
# somebody wrote: the case is the oracle, and the sentence has to be read.
#
# Two things it cannot do, both recorded because a reader will meet them.
# A message written as a ternary comes back with both arms joined -- there are
# two, at ParserType.cpp's `explicit` and ParserTemplate.cpp's class/function
# template -- and no filter can tell a refusal from an ordinary diagnostic that
# happens to say "yet", so a handful of ordinary errors are listed and marked
# in the document rather than filtered here, where filtering them would be a
# judgement hidden in a script.

import os
import re
import sys

CALL = re.compile(r"\b(?:src_\.)?(?:fail|refuse|refuseTemplateId)\s*\(")
LIT = re.compile(r'"((?:[^"\\]|\\.)*)"')
# The two phrasings a refusal is written in, plus the bare "yet" that eleven of
# them use instead. `dynamic_cast`'s message carries only the third, which is
# why one grep does not find this list and this script exists.
MARK = re.compile(r"not supported|not implemented|is C\+\+1[0-9]|\byet\b", re.I)
SRC = re.compile(r"\.(cpp|h)$")


def call_text(lines, i):
    depth, out = 0, []
    for j in range(i, min(i + 14, len(lines))):
        out.append(lines[j])
        depth += lines[j].count("(") - lines[j].count(")")
        if depth <= 0 and "(" in "".join(out):
            break
    return "".join(out)


def message(text):
    body = text[text.index("(") + 1:]
    parts, pos, hole = [], 0, False
    for m in LIT.finditer(body):
        if pos and re.search(r"[A-Za-z_)\]]\s*\+", body[pos:m.start()] + " "):
            hole = True
        if hole and parts:
            parts.append("<...>")
            hole = False
        parts.append(m.group(1))
        pos = m.end()
    if re.search(r"\+\s*[A-Za-z_][A-Za-z0-9_.:>()\[\]-]*\s*(\)|;)", body[pos:]):
        parts.append("<...>")
    return " ".join("".join(parts).replace('\\"', "'").replace("\\n", " ").split())


# The SSA lowering refuses with `outside(...)` (valid C++11 not built yet, owed) or `broken(...)` (a record that
# cannot disagree in a valid program: an internal error). An outside() message is cited by its text, in the
# document's ```owed block, because the lowering's lines move every round; broken() is counted, not cited.
LOWER = re.compile(r"\b(outside|broken)\s*\(")


def lowering(root="src/ir"):
    rows = []
    for dirpath, _, names in os.walk(root):
        for n in sorted(names):
            if not n.endswith(".cpp"):
                continue
            path = os.path.join(dirpath, n).replace(os.sep, "/")
            lines = open(os.path.join(dirpath, n), encoding="utf-8", errors="replace").readlines()
            for i, line in enumerate(lines):
                for m in LOWER.finditer(line):
                    if "void Lowering::" in line or not LIT.search("".join(lines[i:i + 3])[m.end():]):
                        continue
                    text = call_text([line[m.start():]] + lines[i + 1:], 0)
                    lead = re.match(r"\w+\s*\(\s*[A-Za-z_]", text)
                    rows.append((f"{path}:{i + 1}", m.group(1), ("<...>" if lead else "") + message(text)))
    return rows


def owed(doc):
    block = re.search(r"^```owed\n(.*?)^```", doc, re.S | re.M)
    return set(l.strip() for l in block.group(1).splitlines() if l.strip()) if block else set()


def inventory(root="src"):
    rows = []
    for dirpath, _, names in os.walk(root):
        for n in sorted(names):
            if not SRC.search(n):
                continue
            path = os.path.join(dirpath, n)
            lines = open(path, encoding="utf-8", errors="replace").readlines()
            # The document cites `src/parser/X.cpp`; on Windows os.walk spells it with
            # backslashes and every citation read as stale (found on the box, 2026-10-08).
            path = path.replace(os.sep, "/")
            for i, line in enumerate(lines):
                if not CALL.search(line):
                    continue
                text = call_text(lines, i)
                if not MARK.search(text):
                    continue
                msg = message(text)
                if msg and MARK.search(msg):
                    rows.append((f"{path}:{i + 1}", msg))
    return rows


def main():
    args = sys.argv[1:]
    rows = inventory()

    low = lowering()
    lout = [r for r in low if r[1] == "outside"]
    lbroken = [r for r in low if r[1] == "broken"]
    reasons = set(m for _, _, m in lout)
    if args and args[0] == "--count":
        print(f"{len(rows)} refusal sites, {len(set(m for _, m in rows))} distinct messages")
        print(f"the SSA lowering: {len(lout)} outside() sites, {len(reasons)} distinct reasons;"
              f" {len(lbroken)} broken() sites")
        return 0

    if args and args[0] == "--lowering":
        for site, kind, msg in low:
            print(f"{site}\t{kind}\t{msg}")
        return 0

    if args and args[0] == "--check":
        if len(args) < 2:
            print("usage: tools/exclusions --check docs/EXCLUSIONS.md", file=sys.stderr)
            return 2
        doc = open(args[1], encoding="utf-8").read()
        cited = set(re.findall(r"[A-Za-z0-9_/]+\.(?:cpp|h):\d+", doc))
        have = set(site for site, _ in rows)
        missing = sorted(s for s in have if s.replace("src/", "") not in cited and s not in cited)
        stale = sorted(c for c in cited if not any(s.endswith(c) or s == c for s in have))
        cases = sorted(set(re.findall(r"tests/(?:cases|open|overload)/[A-Za-z0-9_.-]+\.(?:cpp|error|notarget|nonames|clang)", doc)))
        gone = [c for c in cases if not os.path.exists(c)]
        for s in missing:
            print(f"not in the document: {s}  {dict(rows)[s]}")
        for c in stale:
            print(f"cited and gone:      {c}")
        for c in gone:
            print(f"case cited and gone: {c}")
        listed = owed(doc)
        lmissing = sorted(reasons - listed)
        lstale = sorted(listed - reasons)
        for m in lmissing:
            print(f"owed, not in the document: {m}  ({next(s for s, _, x in lout if x == m)})")
        for m in lstale:
            print(f"owed, listed and gone:     {m}")
        print(f"\n{len(have)} sites, {len(missing)} uncited, {len(stale) + len(gone)} stale citations"
              f" ({len(cases)} hand-written entries name a test file, {len(gone)} missing)")
        print(f"the SSA lowering: {len(lout)} outside() sites, {len(reasons)} reasons, {len(lmissing)} uncited,"
              f" {len(lstale)} stale; {len(lbroken)} broken() sites, internal errors, not cited")
        return 1 if (missing or stale or gone or lmissing or lstale) else 0

    for site, msg in rows:
        print(f"{site}\t{msg}")
    return 0


sys.exit(main())
