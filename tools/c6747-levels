#!/bin/sh
# The kernels against both CCS toolchains at both levels, on the Windows box's C6747
# cycle-accurate simulator, from the Mac:
#
#   tools/c6747-levels [dir]        every .c and .cpp in dir (default tools/c6747/bench)
#
# Eight builds of each program run at once there (tools/c6747/bench-levels.cmd, each run
# capped at 30 minutes): cl6x 7.4.4 (CCS 5.5) and cl6x 8.2.2 (CCS 7.4) at -O1, -O2 and
# -O2 -ms3, each with its own linker and rts6740_elf_eh.lib; and cpp11 -O1, -O2 and -Os, compiled
# here, assembled by ASM6x and linked by 7.4.4 - and, where LNK6x is built beside this tree and
# the box's 7.4.4 library is in $TILIB, the same objects linked by LNK6x here, `cpp11-O1-lnk6x`
# and `cpp11-O2-lnk6x`, so cpp11 + ASM6x + LNK6x is timed as one toolchain). The table is
# cycle.Total per build, cpp11's ratio to each TI compiler at the same level, the code bytes of
# each program's own object (its executable sections, the library excluded) and each image's
# bytes. A program passes a build when its stdout is its .expected. Everything lands in
# C:\cxx1\bench-levels\<stamp>, a folder of its own; KEEP=<dir> keeps the images and maps.
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
WINDOWS=${CXX1_WINDOWS:-windows}
CPP11=${CPP11:-$ROOT/cpp11.exe}
ASM6X=${ASM6X:-$ROOT/../../TI/ASM6x/build/asm6x.exe}
# COMPRESS=1 (default): cpp11's objects --compress, cl6x its own default, compressed; COMPRESS=0:
# both plain, ASM6x and cl6x --no_compress - the two sides always built alike
COMPRESS=${COMPRESS:-1}
if [ "$COMPRESS" = 1 ]; then ASM6X_FLAGS=--compress; TI_COMPRESS=; else ASM6X_FLAGS=--no_compress; TI_COMPRESS=--no_compress; fi
[ -x "$ASM6X" ] || ASM6X=$HOME/Developer/Claude/TI/ASM6x/build/asm6x.exe   # from a worktree under .claude/
LNK6X=${LNK6X:-$ROOT/../../TI/LNK6x/build/lnk6x.exe}
[ -x "$LNK6X" ] || LNK6X=$HOME/Developer/Claude/TI/LNK6x/build/lnk6x.exe
MAP=${MAP:-C6747.cmd}
TILIB=${TILIB:-$HOME/c6747-lib}   # a copy of the box's C:\cxx1\c6747-lib: rts6740_elf_eh.lib from 7.4.4's mklib
STAMP=${STAMP:-$(date +%m%d-%H%M%S)}
WREMOTE="C:\\cxx1\\bench-levels\\$STAMP"
DIR=${1:-$ROOT/tools/c6747/bench}
T0=$(date +%s)

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/bl"
for f in runca.js c6747ca-windows.ccxml par-one.cmd bench-levels.cmd start-detached.ps1; do cp "$ROOT/tools/c6747/$f" "$WORK/bl/"; done
cp "$ROOT/tools/c6747/$MAP" "$WORK/bl/C6747.cmd"   # MAP=C6747-ddr.cmd for a program past SHRAM's 128 KB
NAMES=""
for p in "$DIR"/*.c "$DIR"/*.cpp; do
    [ -f "$p" ] || continue
    case "$(basename "$p")" in *" "[0-9]*) continue;; esac
    n=$(basename "$p"); n=${n%.*}
    cp "$p" "$WORK/bl/"
    [ -f "$DIR/$n.expected" ] && cp "$DIR/$n.expected" "$WORK/bl/"
    NAMES="$NAMES $n"
    cp "$p" "$WORK/$n.cpp"
    for L in O1 O2 Os; do
        if "$CPP11" -arch tms6747 -nologo -$L -S "$WORK/$n.cpp" -o "$WORK/$n.$L.s" > "$WORK/$n.$L.log" 2>&1 &&
           "$ASM6X" $ASM6X_FLAGS "$WORK/$n.$L.s" -o "$WORK/bl/$n.cpp11-$L.obj" >> "$WORK/$n.$L.log" 2>&1; then :
        else echo "c6747-levels: cpp11 -$L did not build $n:"; sed 's/^/      /' "$WORK/$n.$L.log" | head -4; continue; fi
        # LNK6x's image of the same object, made here from the command file and library TI's linker gets.
        [ -x "$LNK6X" ] && [ -f "$TILIB/rts6740_elf_eh.lib" ] || continue
        if "$LNK6X" --cgt=7.4.4 -mv6740 --abi=eabi "$WORK/bl/$n.cpp11-$L.obj" --heap_size=0x800 --stack_size=0x800 -i"$TILIB" \
              --rom_model "$ROOT/tools/c6747/$MAP" -lrts6740_elf_eh.lib -m "$WORK/bl/$n.cpp11-$L-lnk6x.map" \
              -o "$WORK/bl/$n.cpp11-$L-lnk6x.out" > "$WORK/$n.$L.lnk6x.log" 2>&1; then :
        else echo "c6747-levels: LNK6x did not link $n -$L:"; sed 's/^/      /' "$WORK/$n.$L.lnk6x.log" | head -4; fi
    done
done
if [ "${RESUME:-0}" != 1 ]; then
COPYFILE_DISABLE=1 tar -C "$WORK" --no-xattrs -czf "$WORK/bl.tgz" bl
scp -q -o BatchMode=yes "$WORK/bl.tgz" "$WINDOWS:C:/cxx1/bl-$STAMP.tgz" || { echo "c6747-levels: cannot ship to $WINDOWS"; exit 1; }
ssh -o BatchMode=yes "$WINDOWS" "mkdir C:\\cxx1\\bench-levels 2>nul & mkdir $WREMOTE && tar -C $WREMOTE --strip-components=1 -xzf C:\\cxx1\\bl-$STAMP.tgz && del C:\\cxx1\\bl-$STAMP.tgz" > /dev/null 2>&1
fi
printf 'c6747-levels: running in %s\n' "$WREMOTE"
# **Detached, so a lost connection or a power cut kills no run**: the box job is started through WMI (start-detached.ps1)
# with its own log, and polled for bench-levels.done. `STAMP=<that> RESUME=1` picks up a broken one.
boot() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$WINDOWS" \
    'powershell -NoProfile -Command "(Get-CimInstance Win32_OperatingSystem).LastBootUpTime.Ticks"' 2>/dev/null | tr -d '\r'; }
launch() {   # $1: RESUME, 0 or 1
    printf '@echo off\r\nset TI_COMPRESS=%s\r\nset RESUME=%s\r\ncall "%s\\bench-levels.cmd" > "%s\\windows.log" 2>&1\r\n' \
        "$TI_COMPRESS" "$1" "$WREMOTE" "$WREMOTE" > "$WORK/launch.cmd"
    scp -q -o BatchMode=yes "$WORK/launch.cmd" "$WINDOWS:C:/cxx1/bench-levels/$STAMP/launch.cmd" &&
    ssh -o BatchMode=yes "$WINDOWS" "powershell -NoProfile -ExecutionPolicy Bypass -File $WREMOTE\\start-detached.ps1 $WREMOTE\\launch.cmd" > /dev/null 2>&1
}
launch "${RESUME:-0}" || { echo "c6747-levels: cannot reach $WINDOWS"; exit 1; }
booted=$(boot)
# A box that restarted - a power cut - lost the job with it: started again, it keeps what was measured.
LIMIT=${LIMIT:-7200}; waited=0
until ssh -o BatchMode=yes -o ConnectTimeout=10 "$WINDOWS" "if exist $WREMOTE\\bench-levels.done (exit 0) else (exit 1)" 2>/dev/null; do
    [ "$waited" -ge "$LIMIT" ] && { echo "c6747-levels: no bench-levels.done after ${LIMIT}s - rerun with STAMP=$STAMP RESUME=1"; exit 1; }
    sleep 20; waited=$((waited + 20))
    now=$(boot)
    if [ -n "$now" ] && [ -n "$booted" ] && [ "$now" != "$booted" ]; then
        echo "c6747-levels: $WINDOWS restarted - resuming $STAMP"; booted=$now; launch 1
    fi
done
scp -q -o BatchMode=yes "$WINDOWS:C:/cxx1/bench-levels/$STAMP/windows.log" "$WORK/windows.log" 2>/dev/null
mkdir -p "$WORK/back"
scp -q -r -o BatchMode=yes "$WINDOWS:C:/cxx1/bench-levels/$STAMP/*.result" "$WINDOWS:C:/cxx1/bench-levels/$STAMP/*.stdout" "$WORK/back/" 2>/dev/null
scp -q -r -o BatchMode=yes "$WINDOWS:C:/cxx1/bench-levels/$STAMP/obj" "$WORK/back/" 2>/dev/null
mkdir -p "$WORK/back/img"
scp -q -o BatchMode=yes "$WINDOWS:C:/cxx1/bench-levels/$STAMP/*.out" "$WINDOWS:C:/cxx1/bench-levels/$STAMP/*.map" "$WORK/back/img/" 2>/dev/null
[ -n "${KEEP:-}" ] && mkdir -p "$KEEP" && cp -R "$WORK/back" "$WORK/bl" "$KEEP/"

field() { tr -d '\r' < "$1" 2>/dev/null | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1; }
codebytes() {
    [ -f "$1" ] || { echo -; return; }
    python3 - "$1" <<'PY'
import struct, sys
d = open(sys.argv[1], 'rb').read()
shoff, = struct.unpack_from('<I', d, 0x20)
shentsize, shnum = struct.unpack_from('<HH', d, 0x2e)
total = 0
for i in range(shnum):
    h = struct.unpack_from('<IIIIIIIIII', d, shoff + i * shentsize)
    if h[1] == 1 and h[2] & 4: total += h[5]      # SHT_PROGBITS, SHF_EXECINSTR
print(total)
PY
}
BUILDS="744-O1 744-O2 744-ms 822-O1 822-O2 822-ms cpp11-O1 cpp11-O2 cpp11-Os"
[ -f "$WORK/bl/$(echo $NAMES | awk '{print $1}').cpp11-O2-lnk6x.out" ] && BUILDS="$BUILDS cpp11-O1-lnk6x cpp11-O2-lnk6x cpp11-Os-lnk6x"
pass=0; fail=0
echo
echo "cycles (cycle.Total, TI's C6747 cycle-accurate simulator, Windows box):"
printf '%-8s' program; for b in $BUILDS; do printf '%12s' "$b"; done; printf '   verdict\n'
for n in $NAMES; do
    printf '%-8s' "$n"; v=""
    for b in $BUILDS; do
        r=$WORK/back/$n.$b.result; o=$WORK/back/$n.$b.stdout
        count=$(field "$r" count); pc=$(field "$r" pc); ex=$(field "$r" exit)
        printf '%12s' "${count:--}"
        if [ ! -f "$r" ]; then v="$v $b:missing"; fail=$((fail + 1)); continue; fi
        [ -n "$pc" ] && [ "$pc" != "$ex" ] && { v="$v $b:stopped-at-$pc"; fail=$((fail + 1)); continue; }
        if [ -f "$DIR/$n.expected" ]; then
            tr -d '\r' < "$o" > "$o.lf" 2>/dev/null
            cmp -s "$o.lf" "$DIR/$n.expected" && pass=$((pass + 1)) || { v="$v $b:DIFFERS"; fail=$((fail + 1)); }
        else pass=$((pass + 1)); fi
    done
    printf '   %s\n' "${v:-all expected}"
done
echo
echo "cpp11 over cl6x, cycles at the same level (-Os against -O2 -ms3):"
printf '%-8s %10s %10s %10s %10s %10s %10s\n' program "O1/744-O1" "O1/822-O1" "O2/744-O2" "O2/822-O2" "Os/744-ms" "Os/822-ms"
ratio() { case "$1$2" in ""|*[!0-9]*) echo -;; *) echo "scale=2; $1 / $2" | bc;; esac; }
for n in $NAMES; do
    a=$(field "$WORK/back/$n.cpp11-O1.result" count); b=$(field "$WORK/back/$n.cpp11-O2.result" count)
    c=$(field "$WORK/back/$n.cpp11-Os.result" count)
    printf '%-8s %10s %10s %10s %10s %10s %10s\n' "$n" "$(ratio "$a" "$(field "$WORK/back/$n.744-O1.result" count)")" \
        "$(ratio "$a" "$(field "$WORK/back/$n.822-O1.result" count)")" \
        "$(ratio "$b" "$(field "$WORK/back/$n.744-O2.result" count)")" \
        "$(ratio "$b" "$(field "$WORK/back/$n.822-O2.result" count)")" \
        "$(ratio "$c" "$(field "$WORK/back/$n.744-ms.result" count)")" \
        "$(ratio "$c" "$(field "$WORK/back/$n.822-ms.result" count)")"
done
echo
echo "code bytes of the program's own object (executable sections):"
printf '%-8s' program; for b in $BUILDS; do printf '%10s' "$b"; done; printf '\n'
for n in $NAMES; do
    printf '%-8s' "$n"
    for b in $BUILDS; do
        case "$b" in *-lnk6x) f=$WORK/bl/$n.${b%-lnk6x}.obj;; cpp11-*) f=$WORK/bl/$n.$b.obj;; *) f=$WORK/back/obj/$b/$n.obj;; esac
        printf '%10s' "$(codebytes "$f")"
    done
    printf '\n'
done
echo
echo "image bytes (the linked .out):"
printf '%-8s' program; for b in $BUILDS; do printf '%10s' "$b"; done; printf '\n'
for n in $NAMES; do
    printf '%-8s' "$n"
    for b in $BUILDS; do f=$WORK/back/img/$n.$b.out; if [ -f "$f" ]; then printf '%10s' "$(stat -f %z "$f")"; else printf '%10s' -; fi; done
    printf '\n'
done
echo
[ "$fail" -gt 0 ] && { echo "--- windows log"; tr -d '\r' < "$WORK/windows.log" | tail -8; }
printf 'c6747-levels: %s runs as expected, %s not, in %ss; %s kept on the box\n' "$pass" "$fail" "$(( $(date +%s) - T0 ))" "$WREMOTE"
[ "$fail" -eq 0 ]
