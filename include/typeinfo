// <typeinfo> - std::type_info, laid out as each ABI lays every type_info
// object. Itanium: a vtable pointer and the mangled name; `typeid` yields a
// reference to such an object - the library's for a fundamental type, one this
// compiler emits beside a class's vtable or for a pointer - and this class
// reads it. Names are compared by content, so two weak copies of one class's
// object answer the same whether or not the linker folded them. Microsoft: a
// vftable pointer and the decorated name behind a spare word the runtime
// fills with the undecorated one on the first name(); `typeid` names the
// type descriptor `??_R0...@8`, or asks __RTtypeid for a polymorphic object's,
// and the vcruntime's own three functions read it, as vcruntime_typeinfo.h has
// them. Measured from clang -target x86_64-pc-windows-msvc, 2026-09-26.
#ifndef _CXX1_TYPEINFO
#define _CXX1_TYPEINFO

#include <string.h>

#ifdef _WIN32
extern "C" {
struct __std_type_info_data {
    const char *_UndecoratedName;
    const char _DecoratedName[1];
};
struct __type_info_node;
int __std_type_info_compare(const __std_type_info_data *, const __std_type_info_data *);
unsigned long long __std_type_info_hash(const __std_type_info_data *);
const char *__std_type_info_name(__std_type_info_data *, __type_info_node *);
}
// C++ linkage, as vcruntime_typeinfo.h has it: libcmt defines ?__type_info_root_node@@3U__type_info_node@@A.
extern __type_info_node __type_info_root_node;
#endif

// **On Windows type_info is global and std names it**, as vcruntime_typeinfo.h
// has it: cl spells a member `??8type_info@@...`, and a cl function taking a
// `const std::type_info &` is `AEBVtype_info@@`. Anywhere else it is std's own.
#ifndef _WIN32
namespace std {
#endif

class type_info {
public:
#ifdef _WIN32
    const char *name() const { return __std_type_info_name(&_Data, &__type_info_root_node); }
    const char *raw_name() const { return _Data._DecoratedName; }
    bool operator==(const type_info &other) const {
        return __std_type_info_compare(&_Data, &other._Data) == 0;
    }
    bool operator!=(const type_info &other) const { return !(*this == other); }
    bool before(const type_info &other) const {
        return __std_type_info_compare(&_Data, &other._Data) < 0;
    }
    unsigned long long hash_code() const { return __std_type_info_hash(&_Data); }
#else
    const char *name() const { return __name; }
    bool operator==(const type_info &other) const {
        return __name == other.__name || strcmp(__name, other.__name) == 0;
    }
    bool operator!=(const type_info &other) const { return !(*this == other); }
    bool before(const type_info &other) const {
        return strcmp(__name, other.__name) < 0;
    }
    unsigned long hash_code() const {
        unsigned long h = 5381;
        for (const char *p = __name; *p != 0; p++) h = h * 33 + (unsigned char)*p;
        return h;
    }
#endif
private:
    type_info();
    type_info(const type_info &);
    type_info &operator=(const type_info &);
    const void *__vptr;
#ifdef _WIN32
    mutable __std_type_info_data _Data;
#else
    const char *__name;
#endif
};

#ifdef _WIN32
namespace std { typedef ::type_info type_info; }
#else
}
#endif

// What a failed `dynamic_cast` to a reference throws, [expr.dynamic.cast]/9. On the
// Itanium targets the class is the runtime's own - its destructor and what() are
// declared here and defined there, as <new> declares bad_alloc.
#if !defined(_WIN32) && !defined(__TMS320C6X__)
#include <exception>
namespace std {
class bad_cast : public exception {
public:
    bad_cast() {}
    virtual ~bad_cast();
    virtual const char *what() const;
};
}
#endif

#endif
