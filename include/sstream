// <sstream> - the streams that read and write a string.
//
// **They derive from <ostream> and <istream> rather than repeating them**, and
// what makes that possible is one pointer in each base: `ostream::buf_` and
// `istream::src_`. When it is set, the three functions that actually move
// bytes go to the string instead of the `FILE *`, and every `operator<<` and
// `operator>>` above them is reused untouched.
//
// The other way to do it is a virtual `put`, and a virtual is exactly what
// `std::cout` cannot have: it would need a vptr, a vptr needs a constructor,
// and a file-scope object with a constructor is what this compiler refuses.
// So the branch is a pointer test rather than a call through a table.
//
// **These have constructors and the standard streams do not**, which is not an
// inconsistency: an ostringstream is always a local, and a local with a
// constructor has always worked.
#ifndef _CXX1_SSTREAM
#define _CXX1_SSTREAM

#include <istream>
#include <ostream>
#include <string>

namespace std {

class ostringstream : public ostream {
public:
    string s_;

    ostringstream() {
        fp_ = 0;
        which_ = 0;
        state_ = 0;
        buf_ = &s_;
        base_ = 10;
        prec_ = 6;      // [ios_base]'s default, as <iostream> gives the console streams
        fmt_ = 0;
        width_ = 0;
    }

    string str() const { return s_; }
    void str(const string &v) { s_ = v; }
    // How much has been written - the position the next character goes to, never moved back here.
    long tellp() const { return (long)s_.size(); }
    // [ostream.seeks], to the one place this stream writes: its end. Any other is a failure.
    ostringstream &seekp(long off, int dir) {
        const long at = dir == ios_base::beg ? off : (long)s_.size() + off;
        if (at != (long)s_.size()) state_ = 1;
        return *this;
    }
    // [ostringstream.swap]: the two exchange what they hold and how they format, each still
    // writing into its own string.
    void swap(ostringstream &o) {
        s_.swap(o.s_);
        int t;
        t = state_; state_ = o.state_; o.state_ = t;
        t = base_; base_ = o.base_; o.base_ = t;
        t = prec_; prec_ = o.prec_; o.prec_ = t;
        t = fmt_; fmt_ = o.fmt_; o.fmt_ = t;
        t = width_; width_ = o.width_; o.width_ = t;
        char c = fill_; fill_ = o.fill_; o.fill_ = c;
    }
};

class istringstream : public istream {
public:
    string s_;

    istringstream() {
        fp_ = 0;
        which_ = 0;
        state_ = 0;
        s_ = string();
        src_ = &s_;
        pos_ = 0;
    }

    // The string is copied in, not referred to, so it outlives whatever the
    // caller passed - which is what the standard's `istringstream(s)` does too.
    istringstream(const string &from) {
        fp_ = 0;
        which_ = 0;
        state_ = 0;
        s_ = from;
        src_ = &s_;
        pos_ = 0;
    }

    string str() const { return s_; }
    void str(const string &v) { s_ = v; pos_ = 0; state_ = 0; }
};

// **[stringstream]: one string, read and written** - an istream whose source and an ostream whose
// buffer are both s_, so a read sees what was written. Each base keeps its own state, which a
// program that only reads, or only writes, never sees differ.
class stringstream : public istream, public ostream {
public:
    string s_;

    stringstream() { open(); }
    explicit stringstream(const string &from) { open(); s_ = from; }

    string str() const { return s_; }
    void str(const string &v) { s_ = v; istream::pos_ = 0; istream::state_ = 0; }

private:
    void open() {
        istream::fp_ = 0; istream::which_ = 0; istream::state_ = 0; src_ = &s_; pos_ = 0;
        ostream::fp_ = 0; ostream::which_ = 0; ostream::state_ = 0; buf_ = &s_;
        base_ = 10; prec_ = 6; fmt_ = 0; width_ = 0; fill_ = 0;
    }
};

}  // namespace std

#endif
