// <memory> - the owning pointers of [unique.ptr] and [util.smartptr.shared].
//
// **unique_ptr<T>** owns one object and gives it back with `delete`; it moves and does not copy. **shared_ptr<T>** counts its owners in a
// block of its own and deletes the object with the last of them. Its count is a plain integer:
// there are no threads here (<thread> and <atomic> are absent), so it is not atomic.
//
// **What is not here.** `unique_ptr<T[]>` - a partial specialization on an array of unknown
// bound, which this compiler cannot match yet (`is_array<T[]>` meets the same) - a custom deleter, `weak_ptr`, `enable_shared_from_this`, the aliasing
// and converting constructors, `allocator`, and `make_shared` - whose standard form,
// `make_shared<T>(args...)`, gives one template argument and deduces the rest, which this
// compiler does not do yet (docs/EXCLUSIONS.md). Write `shared_ptr<T>(new T(args...))`.
#ifndef _CXX1_MEMORY
#define _CXX1_MEMORY

#include <cstddef>
#include <utility>

namespace std {

template <class T> class unique_ptr {
public:
    typedef T element_type;
    typedef T *pointer;

    unique_ptr() : p_(0) {}
    unique_ptr(std::nullptr_t) : p_(0) {}
    explicit unique_ptr(T *p) : p_(p) {}
    unique_ptr(unique_ptr &&o) : p_(o.p_) { o.p_ = 0; }
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    ~unique_ptr() { delete p_; }

    unique_ptr &operator=(unique_ptr &&o) {
        if (this != &o) { T *old = p_; p_ = o.p_; o.p_ = 0; delete old; }
        return *this;
    }
    unique_ptr &operator=(std::nullptr_t) { reset(); return *this; }

    T *get() const { return p_; }
    T &operator*() const { return *p_; }
    T *operator->() const { return p_; }
    explicit operator bool() const { return p_ != 0; }
    T *release() { T *was = p_; p_ = 0; return was; }
    void reset(T *p = 0) { T *old = p_; p_ = p; delete old; }
    void swap(unique_ptr &o) { T *t = p_; p_ = o.p_; o.p_ = t; }

private:
    T *p_;
};

template <class T> class shared_ptr {
public:
    typedef T element_type;

    shared_ptr() : p_(0), n_(0) {}
    shared_ptr(std::nullptr_t) : p_(0), n_(0) {}
    explicit shared_ptr(T *p) : p_(p), n_(p ? new long(1) : 0) {}
    shared_ptr(const shared_ptr &o) : p_(o.p_), n_(o.n_) { if (n_) ++*n_; }
    shared_ptr(shared_ptr &&o) : p_(o.p_), n_(o.n_) { o.p_ = 0; o.n_ = 0; }
    ~shared_ptr() { drop(); }

    shared_ptr &operator=(const shared_ptr &o) {
        if (n_ != o.n_) { if (o.n_) ++*o.n_; drop(); p_ = o.p_; n_ = o.n_; }
        return *this;
    }
    shared_ptr &operator=(shared_ptr &&o) {
        if (this != &o) { drop(); p_ = o.p_; n_ = o.n_; o.p_ = 0; o.n_ = 0; }
        return *this;
    }

    T *get() const { return p_; }
    T &operator*() const { return *p_; }
    T *operator->() const { return p_; }
    explicit operator bool() const { return p_ != 0; }
    long use_count() const { return n_ ? *n_ : 0; }
    bool unique() const { return use_count() == 1; }
    void reset() { drop(); p_ = 0; n_ = 0; }
    void reset(T *p) { drop(); p_ = p; n_ = p ? new long(1) : 0; }
    void swap(shared_ptr &o) {
        T *t = p_; p_ = o.p_; o.p_ = t;
        long *m = n_; n_ = o.n_; o.n_ = m;
    }

private:
    void drop() {
        if (n_ && --*n_ == 0) { delete p_; delete n_; }
    }
    T *p_;
    long *n_;
};

template <class T> bool operator==(const shared_ptr<T> &a, const shared_ptr<T> &b) { return a.get() == b.get(); }
template <class T> bool operator!=(const shared_ptr<T> &a, const shared_ptr<T> &b) { return a.get() != b.get(); }

}  // namespace std

#endif
