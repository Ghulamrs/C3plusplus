// <set> - an ordered set, on the same tree as `<map>`.
//
// What a set adds over a map is only that the element *is* the key, so there is no pair and
// `*it` is the value - which a set's iterator does not let be written, since writing it could
// put the tree out of order. Insertion invalidates no iterator and erasure only the erased one.
#ifndef _CXX1_SET
#define _CXX1_SET

#include <cstddef>
#include <utility>
#include <__tree>

namespace std {

template <class T>
struct __set_key {
    typedef T key_type;
    static const T &get(const T &v) { return v; }
};

template <class T>
class set {
public:
    typedef T key_type;
    typedef T value_type;
    typedef std::size_t size_type;
    typedef __tree_const_iterator<T> iterator;
    typedef __tree_const_iterator<T> const_iterator;

    set() {}
    template <class It>
    set(It first, It last) { insert(first, last); }

    size_type size() const { return tree_.size(); }
    bool empty() const { return tree_.empty(); }
    void clear() { tree_.clear(); }
    void swap(set &other) { tree_.swap(other.tree_); }

    const_iterator begin() const { return tree_.begin(); }
    const_iterator end() const { return tree_.end(); }

    const_iterator find(const T &v) const { return const_iterator(tree_.findLink(v), tree_.end().link()); }
    size_type count(const T &v) const { return tree_.findLink(v) != tree_.end().link() ? 1 : 0; }
    const_iterator lower_bound(const T &v) const { return const_iterator(tree_.lowerLink(v), tree_.end().link()); }
    const_iterator upper_bound(const T &v) const { return const_iterator(tree_.upperLink(v), tree_.end().link()); }

    // [associative.reqmts]: where the element is, and whether this call put it there.
    std::pair<iterator, bool> insert(const T &v) {
        bool made;
        __tree_link *n = tree_.insertUnique(v, &made);
        return std::pair<iterator, bool>(iterator(n, tree_.end().link()), made);
    }
    // A hint is where to start looking; the answer is where the element is.
    iterator insert(iterator, const T &v) { return insert(v).first; }
    template <class It>
    void insert(It first, It last) { for (; first != last; ++first) insert(*first); }

    size_type erase(const T &v) {
        __tree_link *n = tree_.findLink(v);
        if (n == tree_.end().link()) return 0;
        tree_.eraseLink(n);
        return 1;
    }
    iterator erase(iterator at) {
        iterator next = at;
        ++next;
        tree_.eraseLink(at.link());
        return next;
    }

private:
    __tree<T, __set_key<T> > tree_;
};

template <class T>
bool operator==(const set<T> &a, const set<T> &b) { return __tree_equal(a, b); }
template <class T>
bool operator!=(const set<T> &a, const set<T> &b) { return !__tree_equal(a, b); }
template <class T>
bool operator<(const set<T> &a, const set<T> &b) { return __tree_less(a, b); }

}  // namespace std

#endif
