// <vector> - a growing array.
//
// **The iterator is a pointer.** `vector<T>::iterator` is `T *` and nothing
// more, which is the simplification that makes this header short: `++it`, `*it`,
// `it->m`, `it != v.end()` and `std::copy(v.begin(), v.end(), ...)` are all the
// built-in operations on a pointer, so none of them has to be written here. A
// conforming library wraps the pointer in a class to catch a `vector<int>`
// iterator being compared against a `vector<char>` one; this does not, and that
// is the cost.
//
// It follows that **any insertion invalidates every iterator**, as it does in a
// real vector when the buffer is regrown, and that `begin()` on an empty vector
// answers null rather than a valid one-past-the-end - which is why `begin()` and
// `end()` are both null then, and comparing them still works.
//
// **The elements are owned, from construction to destruction** (L03, 2026-10-13). The buffer is
// raw storage; an element is made in it by placement new - copy-constructed, or `T()` for
// value-initialisation - and destroyed by name when `pop_back`, `clear`, `erase`, `resize` down,
// the assignment, a regrowth or the destructor drops it. A shift inside the buffer is the
// element's own assignment. `at()` is checked: std::out_of_range, on every target since 1.27
// (2026-10-21, review of 1.25, item 4) - x86_64-windows throws a class since 1.10, and until then
// this printed a message and aborted where cl's throws, which a program catching the exception
// could see (L04 closed).
//
// **An element is moved where the standard moves it** (1.27, the same review): `push_back(T &&)`,
// the regrowth and the shifts of insert and erase move, so a move-only type lives in a vector and
// a program counting its copies counts what it counts under cl; the vector itself has a move
// constructor and a move assignment, which take the buffer and leave the source empty. The one
// simplification: a regrowth moves whether or not the move constructor is noexcept, where
// [vector.modifiers] copies a type whose move may throw.
#ifndef _CXX1_VECTOR
#define _CXX1_VECTOR

#include <cstddef>
#include <cstdlib>
#include <initializer_list>
#include <new>
#include <utility>
#include <type_traits>
#include <stdexcept>

namespace std {

inline void __vector_range_fail(std::size_t i, std::size_t n) {
    (void)i; (void)n;
    throw out_of_range("vector::at");
}

template <class T>
class vector {
public:
    typedef std::size_t size_type;
    typedef T *iterator;
    typedef const T *const_iterator;

    vector() : items_(0), size_(0), cap_(0) {}
    vector(const vector &o) : items_(0), size_(0), cap_(0) { copyFrom(o); }
    // The buffer changes hands; the source is empty afterwards, as [container.requirements] has it.
    vector(vector &&o) : items_(o.items_), size_(o.size_), cap_(o.cap_) { o.items_ = 0; o.size_ = 0; o.cap_ = 0; }
    vector(size_type n, const T &v) : items_(0), size_(0), cap_(0) {
        reserve(n);
        for (size_type i = 0; i < n; i++) push_back(v);
    }
    // **`vector<T> v(n)` is n value-initialised elements** - zero for a scalar,
    // the default constructor for a class - and `explicit`, as the standard
    // makes it, so `vector<int> v = 5;` is refused rather than being read as a
    // vector of five.
    explicit vector(size_type n) : items_(0), size_(0), cap_(0) {
        reserve(n);
        for (size_type i = 0; i < n; i++) { new (items_ + i) T(); size_++; }
    }
    // **`vector<T> v{a, b, c}`** - [sequence.reqmts]: the braced list arrives as
    // one std::initializer_list and its elements are copied in order. Reserved
    // first, so one allocation serves the whole list however long it is.
    vector(std::initializer_list<T> list) : items_(0), size_(0), cap_(0) {
        reserve(list.size());
        for (typename std::initializer_list<T>::const_iterator it = list.begin();
             it != list.end(); ++it)
            push_back(*it);
    }

    // [sequence.reqmts]/14: two iterators copy their range. Two integers are not iterators, so
    // `vector<int> v(3, 5)` and `vector<T *> v(3, 0)` reach (n, v) above, as the standard has it.
    template <class It, class = typename std::enable_if<!std::is_integral<It>::value>::type>
    vector(It first, It last) : items_(0), size_(0), cap_(0) {
        for (; first != last; ++first) push_back(*first);
    }

    ~vector() { clear(); std::free(items_); }

    vector &operator=(const vector &o) {
        if (this != &o) {
            clear();
            copyFrom(o);
        }
        return *this;
    }
    vector &operator=(vector &&o) {
        if (this != &o) {
            clear();
            std::free(items_);
            items_ = o.items_; size_ = o.size_; cap_ = o.cap_;
            o.items_ = 0; o.size_ = 0; o.cap_ = 0;
        }
        return *this;
    }

    // `v` may be an element of this vector, so it is copied before a regrowth frees it.
    void push_back(const T &v) {
        if (size_ == cap_) {
            T keep(v);
            grow(cap_ == 0 ? 4 : cap_ * 2);
            new (items_ + size_) T(std::move(keep));
        } else {
            new (items_ + size_) T(v);
        }
        size_++;
    }
    // An rvalue is moved in - the one road a move-only element has into a vector.
    void push_back(T &&v) {
        if (size_ == cap_) {
            T keep(std::move(v));
            grow(cap_ == 0 ? 4 : cap_ * 2);
            new (items_ + size_) T(std::move(keep));
        } else {
            new (items_ + size_) T(std::move(v));
        }
        size_++;
    }
    // [sequence.reqmts] emplace_back: the element is made in place from the arguments, forwarded.
    template <class... A>
    void emplace_back(A &&... a) {
        if (size_ == cap_) grow(cap_ == 0 ? 4 : cap_ * 2);
        new (items_ + size_) T(std::forward<A>(a)...);
        size_++;
    }
    void pop_back() { if (size_ != 0) { size_--; items_[size_].~T(); } }

    size_type size() const { return size_; }
    bool empty() const { return size_ == 0; }
    void clear() { while (size_ != 0) { size_--; items_[size_].~T(); } }

    // **`assign(n, v)` is clear-then-fill**, which is what the standard says it
    // is for the count-and-value form, and `swap` exchanges the two vectors'
    // insides rather than their elements - so an iterator into either follows
    // its own elements, and neither copies anything.
    void assign(size_type n, const T &v) {
        clear();
        for (size_type i = 0; i < n; i++) push_back(v);
    }
    // The range form, held from two integers as the range constructor is.
    template <class It, class = typename std::enable_if<!std::is_integral<It>::value>::type>
    void assign(It first, It last) {
        clear();
        for (; first != last; ++first) push_back(*first);
    }
    void swap(vector &other) {
        T *d = items_; items_ = other.items_; other.items_ = d;
        size_type s = size_; size_ = other.size_; other.size_ = s;
        size_type c = cap_; cap_ = other.cap_; other.cap_ = c;
    }

    T &operator[](size_type i) { return items_[i]; }
    const T &operator[](size_type i) const { return items_[i]; }
    T &at(size_type i) { if (i >= size_) std::__vector_range_fail(i, size_); return items_[i]; }
    const T &at(size_type i) const { if (i >= size_) std::__vector_range_fail(i, size_); return items_[i]; }

    T &back() { return items_[size_ - 1]; }
    const T &back() const { return items_[size_ - 1]; }
    T &front() { return items_[0]; }
    const T &front() const { return items_[0]; }

    iterator begin() { return items_; }
    iterator end() { return items_ + size_; }
    const_iterator begin() const { return items_; }
    const_iterator end() const { return items_ + size_; }

    void reserve(size_type n) { if (n > cap_) grow(n); }

    void resize(size_type n, const T &v) {
        if (n > size_) {
            T keep(v);
            reserve(n);
            while (size_ < n) { new (items_ + size_) T(keep); size_++; }
        }
        while (size_ > n) { size_--; items_[size_].~T(); }
    }
    // Growing value-initialises the new elements, `T()`; shrinking destroys the tail.
    void resize(size_type n) {
        if (n > size_) {
            reserve(n);
            while (size_ < n) { new (items_ + size_) T(); size_++; }
        }
        while (size_ > n) { size_--; items_[size_].~T(); }
    }

    // **`insert` and `erase` take a pointer into this vector**, which is what
    // the iterator is. `insert` answers a pointer to the element put in, and
    // that pointer is only good until the next insertion.
    iterator insert(iterator at, const T &v) {
        const size_type where = (size_type)(at - items_);
        T keep(v);
        return insertMoved(where, keep);
    }
    iterator insert(iterator at, T &&v) {
        const size_type where = (size_type)(at - items_);
        T keep(std::move(v));
        return insertMoved(where, keep);
    }
    // **The range forms.** `v.insert(v.end(), o.begin(), o.end())` is how one
    // vector is appended to another without a loop at the call site, and it is
    // what a program reaches for often enough that leaving it out shows.
    //
    // `at` is taken as an offset before anything grows, because `reserve` moves
    // the buffer and would leave the caller's pointer behind. `first` and
    // `last` must not point into this vector - [sequence.reqmts] says so, and
    // the reallocation here is exactly why.
    iterator insert(iterator at, const_iterator first, const_iterator last) {
        const size_type where = (size_type)(at - items_);
        size_type n = 0;
        for (const_iterator p = first; p != last; p++) n++;
        if (n == 0) return items_ + where;
        reserve(size_ + n);
        // Backwards, so a move within one buffer cannot overwrite what it has not read yet; a slot
        // past the old end is raw and is constructed, one before it is assigned.
        for (size_type i = size_; i-- > where; ) {
            if (i + n >= size_) new (items_ + i + n) T(std::move(items_[i]));
            else items_[i + n] = std::move(items_[i]);
        }
        size_type k = 0;
        for (const_iterator p = first; p != last; p++, k++) {
            if (where + k >= size_) new (items_ + where + k) T(*p);
            else items_[where + k] = *p;
        }
        size_ += n;
        return items_ + where;
    }
    // Any other range - a map's or a set's - is copied out first and inserted as the pointer range above
    // (1.10, 2026-10-20: `v.insert(v.end(), s.begin(), s.end())` from a set had no insert to call). Two
    // pointers of this vector's own type take the form above, a non-template being the better match.
    // Spelled `T *` and `const T *`, which is what iterator and const_iterator are: a member template
    // whose return type is the class's own typedef is "expected a type" to this compiler (1.24).
    template <class It, class = typename std::enable_if<!std::is_integral<It>::value>::type>
    T *insert(T *at, It first, It last) {
        const size_type where = (size_type)(at - items_);
        vector<T> keep(first, last);
        return insert(items_ + where, (const T *)keep.items_, (const T *)(keep.items_ + keep.size_));
    }

    iterator erase(iterator at) {
        const size_type where = (size_type)(at - items_);
        for (size_type i = where; i + 1 < size_; i++) items_[i] = std::move(items_[i + 1]);
        if (size_ != 0) { size_--; items_[size_].~T(); }
        return items_ + where;
    }
    iterator erase(iterator first, iterator last) {
        const size_type where = (size_type)(first - items_);
        const size_type n = (size_type)(last - first);
        if (n == 0) return items_ + where;
        for (size_type i = where; i + n < size_; i++) items_[i] = std::move(items_[i + n]);
        for (size_type k = 0; k < n; k++) { size_--; items_[size_].~T(); }
        return items_ + where;
    }

private:
    void copyFrom(const vector &o) {
        reserve(o.size_);
        for (size_type i = 0; i < o.size_; i++) push_back(o.items_[i]);
    }
    // `keep` is this call's own copy or move of the element, made before a regrowth could free
    // what it was made from; the last element is moved into the raw slot past the end and the
    // rest shift up by their own move assignment, as [vector.modifiers] has them.
    iterator insertMoved(size_type where, T &keep) {
        if (size_ == cap_) grow(cap_ == 0 ? 4 : cap_ * 2);
        if (where == size_) {
            new (items_ + size_) T(std::move(keep));
        } else {
            new (items_ + size_) T(std::move(items_[size_ - 1]));
            for (size_type i = size_ - 1; i > where; i--) items_[i] = std::move(items_[i - 1]);
            items_[where] = std::move(keep);
        }
        size_++;
        return items_ + where;
    }
    // A regrowth moves every element into the new storage and destroys the old ones.
    void grow(size_type want) {
        T *fresh = (T *)std::malloc(want * sizeof(T));
        for (size_type i = 0; i < size_; i++) new (fresh + i) T(std::move(items_[i]));
        for (size_type i = 0; i < size_; i++) items_[i].~T();
        std::free(items_);
        items_ = fresh;
        cap_ = want;
    }

    T *items_;
    size_type size_;
    size_type cap_;
};

// [container.requirements.general]: equal sizes and equal elements; ordered as their sequences are.
template <class T>
bool operator==(const vector<T> &a, const vector<T> &b) {
    if (a.size() != b.size()) return false;
    for (typename vector<T>::size_type i = 0; i < a.size(); i++) if (!(a[i] == b[i])) return false;
    return true;
}
template <class T>
bool operator!=(const vector<T> &a, const vector<T> &b) { return !(a == b); }
template <class T>
bool operator<(const vector<T> &a, const vector<T> &b) {
    for (typename vector<T>::size_type i = 0; i < a.size() && i < b.size(); i++) {
        if (a[i] < b[i]) return true;
        if (b[i] < a[i]) return false;
    }
    return a.size() < b.size();
}

}  // namespace std

#endif
